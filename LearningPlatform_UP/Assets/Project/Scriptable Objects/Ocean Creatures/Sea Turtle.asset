  m_Script: {fileID: 11500000, guid: 743e35424f65fa04b8b7e85a6993e674, type: 3}
  m_Name: Sea Turtle
  m_EditorClassIdentifier: 
  ObjectName: Sea Turtle
  Facts:
  - text: "The Ocean Traveler!\nSea turtles can live for over 50 years and travel
      thousands of kilometers across the ocean.\nThey always return to the same beach
      where they were born to lay their eggs\u2014like they have a built-in GPS!\nWith
      their strong flippers, they glide gracefully through the water like flying
      birds.\nThey help keep the ocean healthy by eating jellyfish and seagrass\u2014they\u2019re
      nature\u2019s cleanup crew!"
