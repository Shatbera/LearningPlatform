  m_Name: Planet_Mars
  m_EditorClassIdentifier: 
  LocalizedObjectName:
    m_TableReference:
      m_TableCollectionName: GUID:6c9825274246e407d8d990969f77224e
    m_TableEntryReference:
      m_KeyId: 13822084505600
      m_Key: 
