  m_Name: Planet_Mercury
  m_EditorClassIdentifier: 
  ObjectName: Mercury
  Facts:
  - text: "Mercury is the closest planet to the Sun \u2014 it\u2019s the first planet
      in our solar system!"
  - text: "It gets super hot during the day (over 400\xB0C) but freezing cold at
      night \u2014 that\u2019s because it has almost no atmosphere to hold heat."
  - text: "One day on Mercury is really long \u2014 it takes about 59 Earth days
      for Mercury to spin around once!"
  - text: "Mercury has no moons \u2014 it\u2019s too close to the Sun to hold onto
      any."
  - text: "Mercury\u2019s surface looks like the Moon \u2014 it\u2019s full of craters
      from space rocks hitting it!"
  BackgroundSprite: {fileID: 21300000, guid: c17ae6062b0056d44ba539dcd1873ec6, type: 3}
