      \u10E5\u10D0\u10DC\u10D4\u10D1\u10E1 \u10E8\u10D4\u10D8\u10EA\u10D0\u10D5\u10E1,
      \u10DB\u10D0\u10D2\u10E0\u10D0\u10DB \u10EA\u10EE\u10DD\u10D5\u10E0\u10D4\u10D1\u10D8\u10E1\u10D7\u10D5\u10D8\u10E1
