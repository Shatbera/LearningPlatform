    m_Localized: "\u10DC\u10D4\u10DE\u10E2\u10E3\u10DC\u10D8\u10E1 \u10D0\u10E2\u10DB\u10DD\u10E1\u10E4\u10D4\u10E0\u10DD\u10E8\u10D8
