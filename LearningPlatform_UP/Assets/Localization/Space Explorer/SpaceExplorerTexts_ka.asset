  - m_Id: 115228465364992
    m_Localized: "\u10D4\u10E1 \u10D3\u10D0\u10DB\u10EC\u10D5\u10D0\u10E0\u10D8 \u10E5\u10D5\u10D0
      \u10D5\u10D4\u10DC\u10D4\u10E0\u10D0\u10E1 \u10D6\u10D4\u10D3\u10D0\u10DE\u10D8\u10E0\u10D6\u10D4\u10D0
      \u10D0\u10E6\u10D4\u10D1\u10E3\u10DA\u10D8, \u10E1\u10D0\u10D3\u10D0\u10EA
      \u10E2\u10D4\u10DB\u10DE\u10D4\u10E0\u10D0\u10E2\u10E3\u10E0\u10D0 460\xB0C-\u10E1
      \u10D0\u10ED\u10D0\u10E0\u10D1\u10D4\u10D1\u10E1 \u2014 \u10DB\u10D6\u10D4\u10E1\u10D7\u10D0\u10DC
      \u10E7\u10D5\u10D4\u10DA\u10D0\u10D6\u10D4 \u10D0\u10EE\u10DA\u10DD\u10E1 \u10DB\u10E7\u10DD\u10E4\u10D8
      \u10DB\u10D4\u10E0\u10D9\u10E3\u10E0\u10D8\u10E1 \u10DB\u10D8\u10E3\u10EE\u10D4\u10D3\u10D0\u10D5\u10D0\u10D3!
      \u10E5\u10D5\u10D0 \u10D2\u10D0\u10DB\u10D1\u10D6\u10D0\u10E0\u10E3\u10DA\u10D8
      \u10D3\u10D0 \u10D2\u10D0\u10DB\u10DD\u10DB\u10E8\u10E0\u10D0\u10DA\u10D8\u10D0
      \u10D5\u10E3\u10DA\u10D9\u10D0\u10DC\u10E3\u10E0\u10D8 \u10E1\u10D8\u10D7\u10D1\u10DD\u10E1\u10D0
      \u10D3\u10D0 \u10EC\u10DC\u10D4\u10D5\u10D8\u10E1 \u10E8\u10D4\u10D3\u10D4\u10D2\u10D0\u10D3."
