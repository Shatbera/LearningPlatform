      m_Items: []
  - m_Id: 31093339185152
    m_Localized: "\u10E3\u10E0\u10D0\u10DC\u10D8 \u10E7\u10D8\u10DC\u10E3\u10DA\u10D8\u10E1
      \u10D2\u10D8\u10D2\u10D0\u10DC\u10E2\u10D8\u10D0 \u2014 \u10D8\u10E1 \u10EB\u10D8\u10E0\u10D8\u10D7\u10D0\u10D3\u10D0\u10D3
      \u10E8\u10D4\u10D3\u10D2\u10D4\u10D1\u10D0 \u10E7\u10D8\u10DC\u10E3\u10DA\u10DD\u10D5\u10D0\u10DC\u10D8
      \u10DB\u10D0\u10E1\u10D0\u10DA\u10D4\u10D1\u10D8\u10E1\u10D2\u10D0\u10DC, \u10E0\u10DD\u10D2\u10DD\u10E0\u10D8\u10EA\u10D0\u10D0
      \u10EC\u10E7\u10D0\u10DA\u10D8, \u10DB\u10D4\u10D7\u10D0\u10DC\u10D8 \u10D3\u10D0
      \u10D0\u10DB\u10D8\u10D0\u10D9\u10D8, \u10D3\u10D0 \u10D0\u10E0\u10D0 \u10DB\u10EE\u10DD\u10DA\u10DD\u10D3
