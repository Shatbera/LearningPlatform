  - m_Id: 26792768299008
    m_Localized: "\u10DA\u10D0\u10D1\u10DD\u10E0\u10D0\u10E2\u10DD\u10E0\u10D8\u10D0"
    m_Metadata:
      m_Items: []
  - m_Id: 29384084807680
    m_Localized: "\u10D3\u10D4\u10D3\u10D0\u10DB\u10D8\u10EC\u10D0 \u10D4\u10E0\u10D7\u10D0\u10D3\u10D4\u10E0\u10D7\u10D8
      \u10DE\u10DA\u10D0\u10DC\u10D4\u10E2\u10D0\u10D0, \u10E0\u10DD\u10DB\u10D4\u10DA\u10D6\u10D4\u10EA
      \u10D5\u10D8\u10EA\u10D8\u10D7 \u10E0\u10DD\u10DB \u10E1\u10D8\u10EA\u10DD\u10EA\u10EE\u10DA\u10D4
      \u10D0\u10E0\u10E1\u10D4\u10D1\u10DD\u10D1\u10E1 \u2014 \u10D4\u10E1 \u10DC\u10D8\u10E8\u10DC\u10D0\u10D5\u10E1,
      \u10E0\u10DD\u10DB \u10DB\u10EA\u10D4\u10DC\u10D0\u10E0\u10D4\u10D4\u10D1\u10D8,
      \u10EA\u10EE\u10DD\u10D5\u10D4\u10DA\u10D4\u10D1\u10D8 \u10D3\u10D0 \u10D0\u10D3\u10D0\u10DB\u10D8\u10D0\u10DC\u10D4\u10D1\u10D8
      \u10D0\u10E5 \u10EA\u10EE\u10DD\u10D5\u10E0\u10DD\u10D1\u10D4\u10DC!"
    m_Metadata:
      m_Items: []
  - m_Id: 29610447200256
    m_Localized: "\u10D3\u10D4\u10D3\u10D0\u10DB\u10D8\u10EC\u10D8\u10E1 \u10D3\u10D0\u10D0\u10EE\u10DA\u10DD\u10D4\u10D1\u10D8\u10D7
      70% \u10EC\u10E7\u10DA\u10D8\u10D7 \u10D0\u10E0\u10D8\u10E1 \u10D3\u10D0\u10E4\u10D0\u10E0\u10E3\u10DA\u10D8,
      \u10D0\u10DB\u10D8\u10E2\u10DD\u10DB \u10DB\u10D0\u10E1 \u10D6\u10DD\u10D2\u10EF\u10D4\u10E0
      \u201E\u10DA\u10E3\u10E0\u10EF \u10DE\u10DA\u10D0\u10DC\u10D4\u10E2\u10D0\u10E1\u201C\u10D0\u10EA
      \u10E3\u10EC\u10DD\u10D3\u10D4\u10D1\u10D4\u10DC."
    m_Metadata:
      m_Items: []
  - m_Id: 29627203444736
    m_Localized: "\u10D3\u10D4\u10D3\u10D0\u10DB\u10D8\u10EC\u10D0\u10D6\u10D4 \u10D0\u10E0\u10D8\u10E1
      \u10F0\u10D0\u10D4\u10E0\u10D8, \u10E0\u10DD\u10DB\u10D4\u10DA\u10E1\u10D0\u10EA
      \u10D5\u10E1\u10E3\u10DC\u10D7\u10E5\u10D0\u10D5\u10D7 \u2014 \u10EB\u10D8\u10E0\u10D8\u10D7\u10D0\u10D3\u10D0\u10D3
      \u10E8\u10D4\u10D3\u10D2\u10D4\u10D1\u10D0 \u10D0\u10D6\u10DD\u10E2\u10D8\u10E1\u10D0
      \u10D3\u10D0 \u10DF\u10D0\u10DC\u10D2\u10D1\u10D0\u10D3\u10D8\u10E1\u10D2\u10D0\u10DC
      \u10D3\u10D0 \u10E1\u10E3\u10DE\u10D4\u10E0 \u10DB\u10DC\u10D8\u10E8\u10D5\u10DC\u10D4\u10DA\u10DD\u10D5\u10D0\u10DC\u10D8\u10D0\u10E1
      \u10E7\u10D5\u10D4\u10DA\u10D0 \u10EA\u10DD\u10EA\u10EE\u10D0\u10DA\u10D8 \u10D0\u10E0\u10E1\u10D4\u10D1\u10D8\u10E1\u10D7\u10D5\u10D8\u10E1!"
    m_Metadata:
      m_Items: []
  - m_Id: 29634644140032
    m_Localized: "\u10D3\u10D4\u10D3\u10D0\u10DB\u10D8\u10EC\u10D0\u10E1 365 \u10D3\u10E6\u10D4
      \u10E1\u10ED\u10D8\u10E0\u10D3\u10D4\u10D1\u10D0 \u10DB\u10D6\u10D8\u10E1 \u10D2\u10D0\u10E0\u10E8\u10D4\u10DB\u10DD
      \u10E8\u10D4\u10DB\u10DD\u10E1\u10D0\u10E6\u10EC\u10D4\u10D5\u10D0\u10D3 \u2014
      \u10D0\u10DB\u10D0\u10E1 \u10E9\u10D5\u10D4\u10DC \u10EC\u10D4\u10DA\u10D8\u10EC\u10D0\u10D3\u10E1
      \u10D5\u10E3\u10EC\u10DD\u10D3\u10D4\u10D1\u10D7!"
    m_Metadata:
      m_Items: []
  - m_Id: 29674401947648
    m_Localized: "\u10D3\u10D4\u10D3\u10D0\u10DB\u10D8\u10EC\u10D0\u10E1 \u10D4\u10E0\u10D7\u10D8
      \u10DB\u10D7\u10D5\u10D0\u10E0\u10D4 \u10F0\u10E7\u10D0\u10D5\u10E1, \u10E0\u10DD\u10DB\u10D4\u10DA\u10D8\u10EA
      \u10DD\u10D9\u10D4\u10D0\u10DC\u10D8\u10E1 \u10DB\u10DD\u10E5\u10EA\u10D4\u10D5\u10D4\u10D1\u10E1
      \u10E5\u10DB\u10DC\u10D8\u10E1 \u10D3\u10D0 \u10E6\u10D0\u10DB\u10D8\u10E1
      \u10EA\u10D0\u10E1 \u10D0\u10DC\u10D0\u10D7\u10D4\u10D1\u10E1."
    m_Metadata:
      m_Items: []
  - m_Id: 29841364606976
    m_Localized: "\u10D8\u10E3\u10DE\u10D8\u10E2\u10D4\u10E0\u10D8 \u10E7\u10D5\u10D4\u10DA\u10D0\u10D6\u10D4
      \u10D3\u10D8\u10D3\u10D8 \u10DE\u10DA\u10D0\u10DC\u10D4\u10E2\u10D0\u10D0 \u10DB\u10D6\u10D8\u10E1
      \u10E1\u10D8\u10E1\u10E2\u10D4\u10DB\u10D0\u10E8\u10D8."
    m_Metadata:
      m_Items: []
  - m_Id: 29881814474752
    m_Localized: "\u10DB\u10D0\u10E1 \u10D2\u10D0\u10E0\u10E8\u10D4\u10DB\u10DD \u10D0\u10E5\u10D5\u10E1
      \u10D3\u10D8\u10D3\u10D8 \u10EC\u10D8\u10D7\u10D4\u10DA\u10D8 \u10DA\u10D0\u10E5\u10D0
      \u2014 \u10E3\u10D6\u10D0\u10E0\u10DB\u10D0\u10D6\u10D0\u10E0\u10D8 \u10E5\u10D0\u10E0\u10D8\u10E8\u10EE\u10D0\u10DA\u10D8,
      \u10E0\u10DD\u10DB\u10D4\u10DA\u10D8\u10EA \u10D0\u10E1\u10DD\u10D1\u10D8\u10D7
      \u10EC\u10D4\u10DA\u10D8\u10D0 \u10D2\u10E0\u10EB\u10D4\u10DA\u10D3\u10D4\u10D1\u10D0."
    m_Metadata:
      m_Items: []
  - m_Id: 29889427136512
    m_Localized: "\u10D8\u10E3\u10DE\u10D8\u10E2\u10D4\u10E0\u10D8 \u10DB\u10D7\u10DA\u10D8\u10D0\u10DC\u10D0\u10D3
      \u10D2\u10D0\u10D6\u10D8\u10E1\u10D2\u10D0\u10DC \u10E8\u10D4\u10D3\u10D2\u10D4\u10D1\u10D0
      \u10D3\u10D0 \u10DB\u10D0\u10E1 \u10DB\u10E7\u10D0\u10E0\u10D8 \u10D6\u10D4\u10D3\u10D0\u10DE\u10D8\u10E0\u10D8
      \u10D0\u10E0 \u10D0\u10E5\u10D5\u10E1."
    m_Metadata:
      m_Items: []
  - m_Id: 29896217714688
    m_Localized: "\u10DB\u10D0\u10E1 \u10F0\u10E7\u10D0\u10D5\u10E1 \u10DB\u10D8\u10DC\u10D8\u10DB\u10E3\u10DB
      95 \u10DB\u10D7\u10D5\u10D0\u10E0\u10D4, \u10DB\u10D0\u10D7 \u10E8\u10DD\u10E0\u10D8\u10E1
      \u10D4\u10D5\u10E0\u10DD\u10DE\u10D0 \u10D3\u10D0 \u10D2\u10D0\u10DC\u10D8\u10DB\u10D4\u10D3\u10D0."
    m_Metadata:
      m_Items: []
  - m_Id: 29904165920768
    m_Localized: "\u10D8\u10E3\u10DE\u10D8\u10E2\u10D4\u10E0\u10D8\u10E1 \u10EB\u10DA\u10D8\u10D4\u10E0\u10D8
      \u10DB\u10D8\u10D6\u10D8\u10D3\u10E3\u10DA\u10DD\u10D1\u10D0 \u10EE\u10D4\u10DA\u10E1
      \u10E3\u10E8\u10DA\u10D8\u10E1 \u10D9\u10DD\u10E1\u10DB\u10DD\u10E1\u10E3\u10E0
      \u10E5\u10D0\u10DC\u10D4\u10D1\u10E1 \u10D3\u10D4\u10D3\u10D0\u10DB\u10D8\u10EC\u10D8\u10E1\u10D9\u10D4\u10DC
      \u10DB\u10DD\u10EB\u10E0\u10D0\u10DD\u10D1\u10D0\u10E8\u10D8 \u10D3\u10D0 \u10EE\u10E8\u10D8\u10E0\u10D0\u10D3
      \u10D7\u10D0\u10D5\u10D0\u10D3 \u10D8\u10D6\u10D8\u10D3\u10D0\u10D5\u10E1 \u10DB\u10D0\u10D7."
    m_Metadata:
      m_Items: []
  - m_Id: 30001876426752
    m_Localized: "\u10DB\u10D0\u10E0\u10E1\u10E1 \u201E\u10EC\u10D8\u10D7\u10D4\u10DA
      \u10DE\u10DA\u10D0\u10DC\u10D4\u10E2\u10D0\u10E1\u201C \u10D4\u10EB\u10D0\u10EE\u10D8\u10D0\u10DC
      \u2014 \u10DB\u10D8\u10E1\u10D8 \u10EC\u10D8\u10D7\u10D4\u10DA\u10D8 \u10E4\u10D4\u10E0\u10D8
      \u10DC\u10D8\u10D0\u10D3\u10D0\u10D2\u10E8\u10D8 \u10D0\u10E0\u10E1\u10D4\u10D1\u10E3\u10DA\u10D8
      \u10E0\u10D9\u10D8\u10DC\u10D8\u10E1 \u10EC\u10E7\u10D0\u10DA\u10DD\u10D1\u10D8\u10D7\u10D0\u10D0,
      \u10E0\u10DD\u10DB\u10D4\u10DA\u10D8\u10EA \u10D3\u10E0\u10DD\u10E1\u10D7\u10D0\u10DC
      \u10D4\u10E0\u10D7\u10D0\u10D3 \u10D3\u10D0\u10DF\u10D0\u10DC\u10D2\u10D3\u10D0."
    m_Metadata:
      m_Items: []
  - m_Id: 30129475543040
    m_Localized: "\u10DB\u10D0\u10E0\u10E1\u10D6\u10D4 \u10DB\u10D3\u10D4\u10D1\u10D0\u10E0\u10D4\u10DD\u10D1\u10E1
      \u10DB\u10D6\u10D8\u10E1 \u10E1\u10D8\u10E1\u10E2\u10D4\u10DB\u10D8\u10E1 \u10E7\u10D5\u10D4\u10DA\u10D0\u10D6\u10D4
      \u10DB\u10D0\u10E6\u10D0\u10DA\u10D8 \u10D5\u10E3\u10DA\u10D9\u10D0\u10DC\u10D8
      \u2014 \u10DD\u10DA\u10D8\u10DB\u10DE\u10D8\u10E1 \u10DB\u10D7\u10D0, \u10E0\u10DD\u10DB\u10D4\u10DA\u10D8\u10EA
      \u10D4\u10D5\u10D4\u10E0\u10D4\u10E1\u10E2\u10D6\u10D4 \u10E1\u10D0\u10DB\u10EF\u10D4\u10E0
      \u10E3\u10E4\u10E0\u10DD \u10DB\u10D0\u10E6\u10D0\u10DA\u10D8\u10D0!"
    m_Metadata:
      m_Items: []
  - m_Id: 30147020316672
    m_Localized: "\u10DB\u10D0\u10E0\u10E1\u10D6\u10D4 \u10D4\u10E0\u10D7\u10D8 \u10D3\u10E6\u10D4
      \u10D7\u10D8\u10D7\u10E5\u10DB\u10D8\u10E1 \u10D3\u10D4\u10D3\u10D0\u10DB\u10D8\u10EC\u10D8\u10E1\u10D0\u10E1
      \u10F0\u10D2\u10D0\u10D5\u10E1 \u2014 \u10DB\u10D8\u10E1\u10D8 \u10EE\u10D0\u10DC\u10D2\u10E0\u10EB\u10DA\u10D8\u10D5\u10DD\u10D1\u10D0\u10D0
      24 \u10E1\u10D0\u10D0\u10D7\u10D8 \u10D3\u10D0 37 \u10EC\u10E3\u10D7\u10D8,
      \u10E0\u10D0\u10EA \u10E1\u10E3\u10DA \u10EA\u10DD\u10E2\u10D0 \u10E3\u10E4\u10E0\u10DD
      \u10D2\u10E0\u10EB\u10D4\u10DA\u10D8\u10D0 \u10D3\u10D4\u10D3\u10D0\u10DB\u10D8\u10EC\u10D8\u10E1
      \u10D3\u10E6\u10D4\u10D6\u10D4."
    m_Metadata:
      m_Items: []
  - m_Id: 30154662338560
    m_Localized: "\u10DB\u10D0\u10E0\u10E1\u10D6\u10D4 \u10E3\u10D6\u10D0\u10E0\u10DB\u10D0\u10D6\u10D0\u10E0\u10D8
      \u10DB\u10E2\u10D5\u10E0\u10D8\u10E1 \u10E5\u10D0\u10E0\u10D8\u10E8\u10EE\u10DA\u10D4\u10D1\u10D8\u10D0
      \u2014 \u10D8\u10E1\u10D8\u10DC\u10D8 \u10DB\u10D7\u10D4\u10DA \u10DE\u10DA\u10D0\u10DC\u10D4\u10E2\u10D0\u10E1
      \u10E4\u10D0\u10E0\u10D0\u10D5\u10D4\u10DC \u10D3\u10D0 \u10E8\u10D4\u10D8\u10EB\u10DA\u10D4\u10D1\u10D0
      \u10E0\u10D0\u10DB\u10D3\u10D4\u10DC\u10D8\u10DB\u10D4 \u10D7\u10D5\u10D4\u10EA
      \u10D2\u10D0\u10D2\u10E0\u10EB\u10D4\u10DA\u10D3\u10D4\u10E1!"
    m_Metadata:
      m_Items: []
  - m_Id: 30161826209792
    m_Localized: "\u10DB\u10D0\u10E0\u10E1\u10D6\u10D4 \u10E8\u10D4\u10E1\u10D0\u10EB\u10DA\u10DD\u10D0
      \u10DD\u10D3\u10D4\u10E1\u10E6\u10D0\u10EA \u10EC\u10E7\u10D0\u10DA\u10D8 \u10E7\u10DD\u10E4\u10D8\u10DA\u10D8\u10E7\u10DD
      \u2014 \u10DB\u10D4\u10EA\u10DC\u10D8\u10D4\u10E0\u10D4\u10D1\u10D8 \u10E4\u10D8\u10E5\u10E0\u10DD\u10D1\u10D4\u10DC,
      \u10E0\u10DD\u10DB \u10EC\u10D0\u10E0\u10E1\u10E3\u10DA\u10E8\u10D8 \u10DE\u10DA\u10D0\u10DC\u10D4\u10E2\u10D0\u10D6\u10D4
      \u10DB\u10D3\u10D8\u10DC\u10D0\u10E0\u10D4\u10D4\u10D1\u10D8, \u10E2\u10D1\u10D4\u10D1\u10D8
      \u10D3\u10D0 sogar \u10DD\u10D9\u10D4\u10D0\u10DC\u10D4\u10D4\u10D1\u10D8\u10EA
      \u10D9\u10D8 \u10D0\u10E0\u10E1\u10D4\u10D1\u10DD\u10D1\u10D3\u10D0!"
    m_Metadata:
      m_Items: []
  - m_Id: 30263844265984
    m_Localized: "\u10DB\u10D4\u10E0\u10D9\u10E3\u10E0\u10D8 \u10E7\u10D5\u10D4\u10DA\u10D0\u10D6\u10D4
      \u10D0\u10EE\u10DA\u10DD\u10E1 \u10DB\u10D3\u10D4\u10D1\u10D0\u10E0\u10D4\u10DD\u10D1\u10E1
      \u10DB\u10D6\u10D4\u10E1\u10D7\u10D0\u10DC \u2014 \u10D8\u10E1 \u10D0\u10E0\u10D8\u10E1
      \u10DB\u10D6\u10D8\u10E1 \u10E1\u10D8\u10E1\u10E2\u10D4\u10DB\u10D8\u10E1 \u10DE\u10D8\u10E0\u10D5\u10D4\u10DA\u10D8
      \u10DE\u10DA\u10D0\u10DC\u10D4\u10E2\u10D0!"
    m_Metadata:
