  - m_Id: 31099894882304
    m_Localized: "\u10E3\u10E0\u10D0\u10DC\u10E1 \u10E0\u10D2\u10DD\u10DA\u10D4\u10D1\u10D8\u10EA
      \u10D0\u10E5\u10D5\u10E1! \u2014 \u10D8\u10E1\u10D8\u10DC\u10D8 \u10EB\u10D0\u10DA\u10D8\u10D0\u10DC
      \u10E1\u10E3\u10E1\u10E2\u10D8\u10D0 \u10D3\u10D0 \u10EB\u10DC\u10D4\u10DA\u10D0\u10D3
      \u10E8\u10D4\u10E1\u10D0\u10DB\u10E9\u10DC\u10D4\u10D5\u10D8, \u10DB\u10D0\u10D2\u10E0\u10D0\u10DB
      \u10E0\u10D4\u10D0\u10DA\u10E3\u10E0\u10D8\u10D0 \u10D3\u10D0 \u10DE\u10DA\u10D0\u10DC\u10D4\u10E2\u10D8\u10E1
      \u10D2\u10D0\u10E0\u10E8\u10D4\u10DB\u10DD \u10D1\u10E0\u10E3\u10DC\u10D0\u10D5\u10E1."
