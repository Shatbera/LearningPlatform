      \u10EC\u10D0\u10E0\u10DB\u10DD\u10D8\u10E5\u10DB\u10DC\u10D0 \u10D0\u10DB\u10DD\u10DC\u10D8\u10E3\u10DB\u10D8\u10E1\u10D2\u10D0\u10DC
      \u10D8\u10E3\u10DE\u10D8\u10E2\u10D4\u10E0\u10D8\u10E1 \u10D6\u10D4\u10D3\u10D0
      \u10D0\u10E2\u10DB\u10DD\u10E1\u10E4\u10D4\u10E0\u10DD\u10E8\u10D8 \u2014 \u10D8\u10E5,
      \u10E1\u10D0\u10D3\u10D0\u10EA \u10D8\u10DB\u10D3\u10D4\u10DC\u10D0\u10D3 \u10EA\u10D8\u10D5\u10D8\u10D0,
      \u10E0\u10DD\u10DB \u10EA\u10D8\u10D3\u10D0\u10DC \u10E5\u10D8\u10DB\u10D8\u10E3\u10E0\u10D8
      \u10D7\u10DD\u10D5\u10DA\u10D8\u10EA \u10D9\u10D8 \u10DB\u10DD\u10D3\u10D8\u10E1!"
    m_Metadata:
      m_Items: []
  - m_Id: 113794340552704
    m_Localized: "\u10D8\u10E3\u10DE\u10D8\u10E2\u10D4\u10E0\u10D8\u10E1 \u10DB\u10D0\u10D2\u10DC\u10D4\u10E2\u10DD\u10E1\u10E4\u10D4\u10E0\u10DD\u10E1
      \u10E1\u10D9\u10D0\u10DC\u10D4\u10E0\u10D8"
    m_Metadata:
      m_Items: []
  - m_Id: 113811130351616
    m_Localized: "\u10D4\u10E1 \u10D3\u10D4\u10E2\u10D4\u10E5\u10E2\u10DD\u10E0\u10D8
      \u10D0\u10E6\u10E0\u10D8\u10EA\u10EE\u10D0\u10D5\u10E1 \u10D8\u10E3\u10DE\u10D8\u10E2\u10D4\u10E0\u10D8\u10E1
      \u10D2\u10D8\u10D2\u10D0\u10DC\u10E2\u10E3\u10E0 \u10DB\u10D0\u10D2\u10DC\u10D4\u10E2\u10E3\u10E0
      \u10D5\u10D4\u10DA\u10E1 \u2014 \u10D8\u10E1 \u10E7\u10D5\u10D4\u10DA\u10D0\u10D6\u10D4
      \u10EB\u10DA\u10D8\u10D4\u10E0\u10D8 \u10DB\u10D0\u10D2\u10DC\u10D4\u10E2\u10DD\u10E1\u10E4\u10D4\u10E0\u10DD\u10D0
      \u10DE\u10DA\u10D0\u10DC\u10D4\u10E2\u10D4\u10D1\u10E1 \u10E8\u10DD\u10E0\u10D8\u10E1
      \u10D3\u10D0 \u10DB\u10D8\u10DA\u10D8\u10DD\u10DC\u10DD\u10D1\u10D8\u10D7 \u10D9\u10D8\u10DA\u10DD\u10DB\u10D4\u10E2\u10E0\u10D6\u10D4
      \u10D5\u10E0\u10EA\u10D4\u10DA\u10D3\u10D4\u10D1\u10D0 \u10D9\u10DD\u10E1\u10DB\u10DD"
    m_Metadata:
      m_Items: []
  - m_Id: 113831808270336
    m_Localized: "\u10F0\u10D8\u10DE\u10DD\u10D7\u10D4\u10E2\u10E3\u10E0\u10D8 \u10D1\u10D8\u10E0\u10D7\u10D5\u10D8\u10E1
      \u10EC\u10DC\u10D4\u10D5\u10D8\u10E1 \u10D9\u10D0\u10DB\u10D4\u10E0\u10D0"
    m_Metadata:
      m_Items: []
  - m_Id: 113843854311424
    m_Localized: "\u10D4\u10E1 \u10DC\u10D8\u10DB\u10E3\u10E8\u10D8 \u10D8\u10DB
      \u10EB\u10D0\u10DA\u10D6\u10D4\u10D3 \u10EB\u10DA\u10D8\u10D4\u10E0 \u10EC\u10DC\u10D4\u10D5\u10D0\u10E1
      \u10D0\u10E1\u10D0\u10EE\u10D0\u10D5\u10E1, \u10E0\u10DD\u10DB\u10D4\u10DA\u10D8\u10EA
      \u10D8\u10E3\u10DE\u10D8\u10E2\u10D4\u10E0\u10D8\u10E1 \u10E1\u10D8\u10E6\u10E0\u10DB\u10D4\u10E8\u10D8\u10D0
      \u2014 \u10D8\u10E5, \u10E1\u10D0\u10D3\u10D0\u10EA \u10DB\u10D4\u10EA\u10DC\u10D8\u10D4\u10E0\u10D4\u10D1\u10D8
      \u10E4\u10D8\u10E5\u10E0\u10DD\u10D1\u10D4\u10DC, \u10E0\u10DD\u10DB \u10D7\u10EE\u10D4\u10D5\u10D0\u10D3\u10D8
      \u10D3\u10D0 \u10D0\u10D8\u10E0\u10D8\u10E1 \u10E4\u10D4\u10DC\u10D4\u10D1\u10D8\u10E1
      \u10E5\u10D5\u10D4\u10E8 \u10E8\u10D4\u10D8\u10EB\u10DA\u10D4\u10D1\u10D0 \u10E5\u10D0\u10DC\u10DD\u10D5\u10D0\u10DC\u10D8
      \u10D1\u10D8\u10E0\u10D7\u10D5\u10D8 \u10D8\u10DB\u10D0\u10DA\u10D4\u10D1\u10DD\u10D3\u10D4\u10E1!"
    m_Metadata:
      m_Items: []
  - m_Id: 113891413524480
    m_Localized: "\u10D3\u10D0\u10DF\u10D0\u10DC\u10D2\u10E3\u10DA\u10D8 \u10DB\u10D0\u10E0\u10E1\u10D8\u10E1
      \u10DC\u10D8\u10D0\u10D3\u10D0\u10D2\u10D8"
    m_Metadata:
      m_Items: []
  - m_Id: 113911978196992
    m_Localized: "\u10D4\u10E1 \u10DB\u10E2\u10D5\u10E0\u10D8\u10D0\u10DC\u10D8 \u10DC\u10D8\u10D0\u10D3\u10D0\u10D2\u10D8
      \u10E1\u10D0\u10D5\u10E1\u10D4\u10D0 \u10E0\u10D9\u10D8\u10DC\u10D8\u10D7,
      \u10E0\u10DD\u10DB\u10D4\u10DA\u10D8\u10EA \u10D3\u10E0\u10DD\u10D7\u10D0 \u10D2\u10D0\u10DC\u10DB\u10D0\u10D5\u10DA\u10DD\u10D1\u10D0\u10E8\u10D8
      \u10D3\u10D0\u10D8\u10DF\u10D0\u10DC\u10D2\u10D0 \u2014 \u10E1\u10EC\u10DD\u10E0\u10D4\u10D3
      \u10D0\u10DB\u10D8\u10E2\u10DD\u10DB \u10E9\u10D0\u10DC\u10E1 \u10DB\u10D0\u10E0\u10E1\u10D8
      \u10D9\u10DD\u10E1\u10DB\u10DD\u10E1\u10D8\u10D3\u10D0\u10DC \u10EC\u10D8\u10D7\u10DA\u10D0\u10D3!\n\u10D3\u10D4\u10D3\u10D0\u10DB\u10D8\u10EC\u10D8\u10E1\u10D2\u10D0\u10DC
      \u10D2\u10D0\u10DC\u10E1\u10EE\u10D5\u10D0\u10D5\u10D4\u10D1\u10D8\u10D7, \u10D4\u10E1
      \u10DF\u10D0\u10DC\u10D2\u10D8 \u10D7\u10D8\u10D7\u10E5\u10DB\u10D8\u10E1 \u10DB\u10D7\u10D4\u10DA
      \u10D6\u10D4\u10D3\u10D0\u10DE\u10D8\u10E0\u10E1 \u10E4\u10D0\u10E0\u10D0\u10D5\u10E1."
    m_Metadata:
      m_Items: []
  - m_Id: 113937680891904
    m_Localized: "\u10D2\u10D0\u10E7\u10D8\u10DC\u10E3\u10DA\u10D8 \u10EC\u10E7\u10DA\u10D8\u10E1
      \u10DC\u10D0\u10DB\u10E1\u10EE\u10D5\u10E0\u10D4\u10D5\u10D8"
    m_Metadata:
      m_Items: []
  - m_Id: 113952780386304
    m_Localized: "\u10D4\u10E1 \u10E7\u10D8\u10DC\u10E3\u10DA\u10D8\u10E1 \u10DE\u10D0\u10E2\u10D0\u10E0\u10D0
      \u10DC\u10D0\u10ED\u10D4\u10E0\u10D8 \u10DB\u10D0\u10E0\u10E1\u10D8\u10E1 \u10E1\u10D0\u10DB\u10EE\u10E0\u10D4\u10D7
      \u10DE\u10DD\u10DA\u10E3\u10E1\u10D8\u10D3\u10D0\u10DC \u10D0\u10E0\u10D8\u10E1
      \u10EC\u10D0\u10DB\u10DD\u10E6\u10D4\u10D1\u10E3\u10DA\u10D8.\n\u10DB\u10D4\u10EA\u10DC\u10D8\u10D4\u10E0\u10D4\u10D1\u10D8
      \u10E4\u10D8\u10E5\u10E0\u10DD\u10D1\u10D4\u10DC, \u10E0\u10DD\u10DB \u10E7\u10D8\u10DC\u10E3\u10DA\u10DD\u10D5\u10D0\u10DC\u10D8
      \u10EC\u10E7\u10D0\u10DA\u10D8 \u10D3\u10E6\u10D4\u10E1\u10D0\u10EA \u10E6\u10E0\u10DB\u10D0\u10D3
      \u10DB\u10D8\u10EC\u10D8\u10E1 \u10E5\u10D5\u10D4\u10E8 \u10D8\u10DB\u10D0\u10DA\u10D4\u10D1\u10D0,
      \u10EE\u10DD\u10DA\u10DD \u10EC\u10D0\u10E0\u10E1\u10E3\u10DA\u10E8\u10D8 \u10DB\u10D0\u10E0\u10E1\u10D6\u10D4
      \u10DB\u10D3\u10D8\u10DC\u10D0\u10E0\u10D4\u10D4\u10D1\u10D8 \u10D3\u10D0 \u10E2\u10D1\u10D4\u10D1\u10D8\u10EA
      \u10D9\u10D8 \u10DB\u10DD\u10D4\u10D3\u10D8\u10DC\u10D4\u10D1\u10DD\u10D3\u10D0."
    m_Metadata:
      m_Items: []
  - m_Id: 113975303798784
    m_Localized: "\u10D7\u10EE\u10D4\u10DA\u10D8 \u10F0\u10D0\u10D4\u10E0\u10D8\u10E1
      \u10D1\u10E3\u10E8\u10E2\u10D8"
    m_Metadata:
      m_Items: []
  - m_Id: 113992370421760
    m_Localized: "\u10D4\u10E1 \u10DE\u10D0\u10E2\u10D0\u10E0\u10D0 \u10F0\u10D0\u10D4\u10E0\u10D8\u10E1
      \u10D1\u10E3\u10E8\u10E2\u10D8 \u10D9\u10D0\u10E0\u10D2\u10D0\u10D3 \u10D0\u10E9\u10D5\u10D4\u10DC\u10D4\u10D1\u10E1,
      \u10E0\u10D0\u10DB\u10D3\u10D4\u10DC\u10D0\u10D3 \u10D8\u10E8\u10D5\u10D8\u10D0\u10D7\u10D8\u10D0
      \u10DB\u10D0\u10E0\u10E1\u10D8\u10E1 \u10D0\u10E2\u10DB\u10DD\u10E1\u10E4\u10D4\u10E0\u10DD.\n\u10D0\u10E5
      \u10D7\u10D8\u10D7\u10E5\u10DB\u10D8\u10E1 \u10E1\u10D0\u10D4\u10E0\u10D7\u10DD\u10D3
      \u10D0\u10E0 \u10D0\u10E0\u10D8\u10E1 \u10DF\u10D0\u10DC\u10D2\u10D1\u10D0\u10D3\u10D8
      \u10D3\u10D0 \u10E1\u10DE\u10D4\u10EA\u10D8\u10D0\u10DA\u10E3\u10E0\u10D8 \u10E1\u10D9\u10D0\u10E4\u10D0\u10DC\u10D3\u10E0\u10D8\u10E1
      \u10D2\u10D0\u10E0\u10D4\u10E8\u10D4 \u10D2\u10D0\u10D3\u10D0\u10E0\u10E9\u10D4\u10DC\u10D0
      \u10E8\u10D4\u10E3\u10EB\u10DA\u10D4\u10D1\u10D4\u10DA\u10D8\u10D0.\n\u10D2\u10D0\u10DC\u10E1\u10EE\u10D5\u10D0\u10D5\u10D4\u10D1\u10E3\u10DA\u10D8
      \u10EC\u10DC\u10D4\u10D5\u10D8\u10E1 \u10D2\u10D0\u10DB\u10DD, \u10EC\u10E7\u10DA\u10D8\u10E1
      \u10D3\u10E3\u10E6\u10D8\u10DA\u10D8\u10EA \u10D9\u10D8 \u10DB\u10D0\u10E0\u10E1\u10D6\u10D4
      \u10E3\u10E9\u10D5\u10D4\u10E3\u10DA\u10DD\u10D3 \u10DB\u10D8\u10DB\u10D3\u10D8\u10DC\u10D0\u10E0\u10D4\u10DD\u10D1\u10E1."
    m_Metadata:
      m_Items: []
  - m_Id: 114005959966720
    m_Localized: "\u10DB\u10D6\u10D8\u10E1 \u10D2\u10D0\u10DB\u10DD\u10E1\u10EE\u10D8\u10D5\u10D4\u10D1\u10D8\u10E1
      \u10E2\u10E0\u10D4\u10D9\u10D4\u10E0\u10D8"
    m_Metadata:
      m_Items: []
  - m_Id: 114016655441920
    m_Localized: "\u10D4\u10E1 \u10DC\u10D8\u10DB\u10E3\u10E8\u10D8 \u10D9\u10DD\u10E1\u10DB\u10DD\u10E1\u10D8\u10D3\u10D0\u10DC
      \u10DB\u10DD\u10DB\u10D0\u10D5\u10D0\u10DA\u10D8 \u10EB\u10DA\u10D8\u10D4\u10E0
      \u10E0\u10D0\u10D3\u10D8\u10D0\u10EA\u10D8\u10D0\u10E1 \u10D0\u10E4\u10D8\u10E5\u10E1\u10D8\u10E0\u10D4\u10D1\u10E1.\n\u10D3\u10D4\u10D3\u10D0\u10DB\u10D8\u10EC\u10D8\u10E1
      \u10DB\u10E1\u10D2\u10D0\u10D5\u10E1\u10D0\u10D3 \u10DB\u10D0\u10D2\u10DC\u10D4\u10E2\u10E3\u10E0\u10D8
      \u10D5\u10D4\u10DA\u10D8\u10E1 \u10D2\u10D0\u10E0\u10D4\u10E8\u10D4, \u10DB\u10D0\u10E0\u10E1\u10D8
      \u10DB\u10E3\u10D3\u10DB\u10D8\u10D5\u10D0\u10D3 \u10D8\u10E6\u10D4\u10D1\u10E1
      \u10DB\u10D6\u10D8\u10E1 \u10EB\u10DA\u10D8\u10D4\u10E0 \u10D2\u10D0\u10DB\u10DD\u10E1\u10EE\u10D8\u10D5\u10D4\u10D1\u10D0\u10E1
      \u2014 \u10D0\u10DB\u10D8\u10E2\u10DD\u10DB \u10DB\u10DD\u10DB\u10D0\u10D5\u10D0\u10DA
      \u10D0\u10E1\u10E2\u10E0\u10DD\u10DC\u10D0\u10D5\u10E2\u10D4\u10D1\u10E1 \u10E1\u10D4\u10E0\u10D8\u10DD\u10D6\u10E3\u10DA\u10D8
      \u10D3\u10D0\u10EA\u10D5\u10D0 \u10D3\u10D0\u10E1\u10ED\u10D8\u10E0\u10D3\u10D4\u10D1\u10D0\u10D7."
    m_Metadata:
      m_Items: []
  - m_Id: 114033873059840
    m_Localized: "\u10E5\u10D0\u10E0\u10D8\u10E8\u10EE\u10DA\u10D8\u10D7 \u10DB\u10DD\u10E2\u10D0\u10DC\u10D8\u10DA\u10D8
      \u10DB\u10E2\u10D5\u10E0\u10D8\u10E1 \u10E4\u10D4\u10DC\u10D0"
    m_Metadata:
      m_Items: []
  - m_Id: 114059282153472
    m_Localized: "\u10D4\u10E1 \u10EC\u10D5\u10E0\u10D8\u10DA\u10D8 \u10DB\u10E2\u10D5\u10D4\u10E0\u10D8
      \u10D8\u10DB \u10E5\u10D0\u10E0\u10D8\u10E8\u10EE\u10DA\u10D8\u10D3\u10D0\u10DC
      \u10DB\u10DD\u10D3\u10D8\u10E1, \u10E0\u10DD\u10DB\u10D4\u10DA\u10DB\u10D0\u10EA
      \u10DB\u10D7\u10D4\u10DA \u10DB\u10D0\u10E0\u10E1\u10E1 \u10D2\u10D0\u10D3\u10D0\u10E3\u10D0\u10E0\u10D0!\n\u10DB\u10D0\u10E0\u10E1\u10D8\u10E1
      \u10E5\u10D0\u10E0\u10D8\u10E8\u10EE\u10DA\u10D4\u10D1\u10D8 \u10D2\u10D8\u10D2\u10D0\u10DC\u10E2\u10E3\u10E0\u10D8\u10D0
      \u10D3\u10D0 \u10D6\u10DD\u10D2\u10EF\u10D4\u10E0 \u10D3\u10E6\u10D4\u10D4\u10D1\u10D8\u10E1
      \u10D2\u10D0\u10DC\u10DB\u10D0\u10D5\u10DA\u10DD\u10D1\u10D0\u10E8\u10D8 \u10D1\u10DA\u10DD\u10D9\u10D0\u10D5\u10E1
      \u10DB\u10D6\u10D8\u10E1 \u10E1\u10D8\u10DC\u10D0\u10D7\u10DA\u10D4\u10E1."
    m_Metadata:
      m_Items: []
  - m_Id: 114072833949696
    m_Localized: "\u10DD\u10DA\u10D8\u10DB\u10DE\u10D8\u10E1 \u10DA\u10D0\u10D5\u10D8\u10E1
      \u10DC\u10D0\u10DB\u10E1\u10EE\u10D5\u10E0\u10D4\u10D5\u10D8"
    m_Metadata:
      m_Items: []
  - m_Id: 114096720510976
    m_Localized: "\u10D4\u10E1 \u10E5\u10D5\u10D0 \u10E8\u10D4\u10E1\u10D0\u10EB\u10DA\u10DD\u10D0
      \u10DD\u10DA\u10D8\u10DB\u10DE\u10D8\u10E1 \u10DB\u10D7\u10D8\u10D3\u10D0\u10DC
      \u10D8\u10E7\u10DD\u10E1 \u2014 \u10D8\u10E1 \u10EE\u10DD\u10DB \u10DB\u10D6\u10D8\u10E1
      \u10E1\u10D8\u10E1\u10E2\u10D4\u10DB\u10D8\u10E1 \u10E7\u10D5\u10D4\u10DA\u10D0\u10D6\u10D4
      \u10D3\u10D8\u10D3\u10D8 \u10D5\u10E3\u10DA\u10D9\u10D0\u10DC\u10D8\u10D0!\n\u10D3\u10E6\u10D4\u10E1
      \u10D8\u10E1 \u10D0\u10E6\u10D0\u10E0 \u10D0\u10E0\u10D8\u10E1 \u10D0\u10E5\u10E2\u10D8\u10E3\u10E0\u10D8,
      \u10DB\u10D0\u10D2\u10E0\u10D0\u10DB \u10D4\u10E0\u10D7 \u10D3\u10E0\u10DD\u10E1
      \u10DB\u10EB\u10D5\u10D8\u10DC\u10D5\u10D0\u10E0\u10D4 \u10DA\u10D0\u10D5\u10D8\u10E1
