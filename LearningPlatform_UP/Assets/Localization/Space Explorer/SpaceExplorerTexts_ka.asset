      \u10E1\u10EE\u10D5\u10D0 \u10D0\u10D8\u10E0\u10D4\u10D1\u10D8.\n\u10D4\u10E1
      \u10D8\u10D3\u10D4\u10D0\u10DA\u10E3\u10E0\u10D0\u10D3 \u10D3\u10D0\u10D1\u10D0\u10DA\u10D0\u10DC\u10E1\u10D4\u10D1\u10E3\u10DA\u10D8
