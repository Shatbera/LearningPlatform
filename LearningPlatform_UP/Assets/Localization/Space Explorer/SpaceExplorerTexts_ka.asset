      \u10DA\u10E3\u10E0\u10EF \u10E4\u10D4\u10E0\u10E1 \u10D0\u10DC\u10D8\u10ED\u10D4\u10D1\u10E1.\n\u10DB\u10D4\u10D7\u10D0\u10DC\u10D8
      \u10E8\u10D7\u10D0\u10DC\u10D7\u10E5\u10D0\u10D5\u10E1 \u10EC\u10D8\u10D7\u10D4\u10DA
