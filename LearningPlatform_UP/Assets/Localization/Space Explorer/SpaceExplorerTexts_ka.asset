      \u10E8\u10DD\u10E0\u10E1\u10D0\u10D0, \u10D8\u10E1 \u10DB\u10D0\u10D8\u10DC\u10EA
      \u10DC\u10D4\u10DE\u10E2\u10E3\u10DC\u10D6\u10D4 \u10EA\u10D8\u10D5\u10D8\u10D0!\n\u10D4\u10E1
      \u10DC\u10D8\u10DB\u10E3\u10E8\u10D8 \u10D0\u10D3\u10D0\u10E1\u10E2\u10E3\u10E0\u10D4\u10D1\u10E1,
      \u10E0\u10DD\u10DB \u10E3\u10E0\u10D0\u10DC\u10E1 \u10D0\u10E5\u10D5\u10E1
      \u10DB\u10D6\u10D8\u10E1 \u10E1\u10D8\u10E1\u10E2\u10D4\u10DB\u10D0\u10E8\u10D8
      \u10E7\u10D5\u10D4\u10DA\u10D0\u10D6\u10D4 \u10EA\u10D8\u10D5\u10D8 \u10D0\u10E2\u10DB\u10DD\u10E1\u10E4\u10D4\u10E0\u10DD
      \u2014 \u10E2\u10D4\u10DB\u10DE\u10D4\u10E0\u10D0\u10E2\u10E3\u10E0\u10D0 \u2013224\xB0C-\u10DB\u10D3\u10D4
      \u10D4\u10EA\u10D4\u10DB\u10D0."
    m_Metadata:
      m_Items: []
