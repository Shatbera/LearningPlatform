      \u10DE\u10DA\u10D0\u10DC\u10D4\u10E2\u10D8\u10E1 \u10E8\u10D8\u10D2\u10DC\u10D8\u10D7.\n\u10EB\u10D0\u10DA\u10D8\u10D0\u10DC
      \u10DB\u10D0\u10E6\u10D0\u10DA\u10D8 \u10EC\u10DC\u10D4\u10D5\u10D0 \u10DC\u10D0\u10EE\u10E8\u10D8\u10E0\u10D1\u10D0\u10D3\u10D8\u10E1
      \u10D0\u10E2\u10DD\u10DB\u10D4\u10D1\u10E1 \u10D9\u10E0\u10D8\u10E1\u10E2\u10D0\u10DA\u10D4\u10D1\u10D0\u10D3
      \u10D0\u10E5\u10EA\u10D4\u10D5\u10E1."
