      \u10D9\u10E0\u10D8\u10E1\u10E2\u10D0\u10DA\u10D8 \u10DB\u10D4\u10E0\u10D9\u10E3\u10E0\u10D8\u10E1
      \u10DB\u10D6\u10D8\u10E1 \u10DB\u10EE\u10D0\u10E0\u10D4\u10E1 \u10D8\u10E5\u10DC\u10D0
      \u10D0\u10E6\u10D4\u10D1\u10E3\u10DA\u10D8, \u10E1\u10D0\u10D3\u10D0\u10EA
