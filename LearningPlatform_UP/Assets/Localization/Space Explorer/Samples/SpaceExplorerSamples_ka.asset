  - m_Id: 599316873218
    m_Localized: "\u10ec\u10e7\u10d0\u10da\u10d8 \u10d0\u10e3\u10ea\u10d8\u10da\u10d4\u10d1\u10d4\u10da\u10d8\u10d0 \u10db\u10ea\u10d4\u10dc\u10d0\u10e0\u10d4\u10d4\u10d1\u10d8\u10e1\u10d7\u10d5\u10d8\u10e1, \u10ea\u10ee\u10dd\u10d5\u10d4\u10da\u10d4\u10d1\u10d8\u10e1\u10d7\u10d5\u10d8\u10e1 \u10d3\u10d0 \u10d0\u10d3\u10d0\u10db\u10d8\u10d0\u10dc\u10d4\u10d1\u10d8\u10e1\u10d7\u10d5\u10d8\u10e1."
    m_Metadata:
      m_Items: []
  - m_Id: 599316873219
    m_Localized: "\u10dc\u10d8\u10d0\u10d3\u10d0\u10d2\u10d8\u10e1 \u10dc\u10d8\u10db\u10e3\u10e8\u10d8"
    m_Metadata:
      m_Items: []
  - m_Id: 599316873220
    m_Localized: "\u10dc\u10d8\u10d0\u10d3\u10d0\u10d2\u10d8 \u10d4\u10ee\u10db\u10d0\u10e0\u10d4\u10d1\u10d0 \u10db\u10ea\u10d4\u10dc\u10d0\u10e0\u10d4\u10d4\u10d1\u10e1 \u10d6\u10e0\u10d3\u10d0\u10e8\u10d8, \u10e0\u10d0\u10d3\u10d2\u10d0\u10dc \u10d0\u10eb\u10da\u10d4\u10d5\u10e1 \u10db\u10d0\u10d7 \u10e1\u10d0\u10d9\u10d5\u10d4\u10d1 \u10dc\u10d8\u10d5\u10d7\u10d8\u10d4\u10e0\u10d4\u10d1\u10d4\u10d1\u10e1."
