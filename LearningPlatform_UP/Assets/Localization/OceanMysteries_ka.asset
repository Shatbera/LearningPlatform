    m_Localized: "\u10D6\u10E6\u10D5\u10D8\u10E1 \u10DB\u10D2\u10D6\u10D0\u10D5\u10E0\u10D8!\n\u10E0\u10D4\u10DB\u10DD\u10E0\u10D0\u10E1
      \u10D7\u10D0\u10D5\u10D8\u10E1 \u10D6\u10D4\u10D3\u10D0 \u10DC\u10D0\u10EC\u10D8\u10DA\u10D6\u10D4
