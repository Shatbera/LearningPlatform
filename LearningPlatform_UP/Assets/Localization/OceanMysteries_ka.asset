  - m_Id: 93987922706432
    m_Localized: "\u10D6\u10E6\u10D5\u10D8\u10E1 \u10D4\u10D9\u10DA\u10D8\u10D0\u10DC\u10D8
      \u10D1\u10E3\u10E0\u10D7\u10D8!\n\u10D6\u10E6\u10D5\u10D8\u10E1 \u10D6\u10E6\u10D0\u10E0\u10D1\u10D4\u10D1\u10D8
      \u10DE\u10D0\u10E2\u10D0\u10E0\u10D0 \u10D1\u10E3\u10E0\u10D7\u10E3\u10DA\u10D4\u10D1\u10E1
      \u10F0\u10D2\u10D5\u10D0\u10DC\u10D0\u10DC, \u10E0\u10DD\u10DB\u10DA\u10D4\u10D1\u10D8\u10EA
      \u10D1\u10D0\u10E1\u10E0\u10D8 \u10D4\u10D9\u10DA\u10D4\u10D1\u10D8\u10D7 \u10D0\u10E0\u10D8\u10D0\u10DC
      \u10D3\u10D0\u10E4\u10D0\u10E0\u10E3\u10DA\u10D8 \u2014 \u10D4\u10E1 \u10D4\u10D9\u10DA\u10D4\u10D1\u10D8
      \u10DB\u10D0\u10D7 \u10DB\u10DD\u10EB\u10E0\u10D0\u10DD\u10D1\u10D0\u10E8\u10D8,
      \u10D3\u10D0\u10EA\u10D5\u10D0\u10E1\u10D0 \u10D3\u10D0 \u10D2\u10D0\u10EC\u10DB\u10D4\u10DC\u10D3\u10D0\u10E8\u10D8
      \u10D4\u10EE\u10DB\u10D0\u10E0\u10D4\u10D1\u10D0!\n\u10D8\u10E1\u10D8\u10DC\u10D8
      \u10DC\u10D4\u10DA\u10D0 \u10D2\u10D0\u10D3\u10D0\u10D3\u10D8\u10D0\u10DC \u10D9\u10DA\u10D3\u10D4\u10D4\u10D1\u10D6\u10D4,
      \u10E5\u10D5\u10D4\u10DB\u10DD\u10D7 \u10D3\u10D0\u10DB\u10D0\u10DA\u10E3\u10DA\u10D8
      \u10DE\u10D0\u10E2\u10D0\u10E0\u10D0 \u10DB\u10D8\u10DA\u10D0\u10D9-\u10E1\u10D0\u10EE\u10E1\u10E0\u10D8\u10D0\u10DC\u10D8
      \u10E4\u10D4\u10EE\u10D4\u10D1\u10D8\u10E1 \u10D3\u10D0\u10EE\u10DB\u10D0\u10E0\u10D4\u10D1\u10D8\u10D7.\n\u10DB\u10D0\u10D7\u10D8
      \u10DE\u10D8\u10E0\u10D8 \u10E5\u10D5\u10D4\u10DB\u10DD\u10D7 \u10DB\u10D3\u10D4\u10D1\u10D0\u10E0\u10D4\u10DD\u10D1\u10E1
      \u10D3\u10D0 \u201E\u10D0\u10E0\u10D8\u10E1\u10E2\u10DD\u10E2\u10D4\u10DA\u10D4\u10E1
      \u10E4\u10D0\u10E0\u10D0\u10DC\u10E1\u201C \u10D4\u10EB\u10D0\u10EE\u10D8\u10D0\u10DC
      \u2014 \u10E1\u10EC\u10DD\u10E0\u10D4\u10D3 \u10DB\u10D8\u10E1\u10D8\u10D7
      \u10D0\u10E1\u10E3\u10E4\u10D7\u10D0\u10D5\u10D4\u10D1\u10D4\u10DC \u10EC\u10E7\u10D0\u10DA\u10E5\u10D5\u10D4\u10E8\u10D0
      \u10D6\u10D4\u10D3\u10D0\u10DE\u10D8\u10E0\u10D4\u10D1\u10E1 \u10EC\u10E7\u10D0\u10DA\u10DB\u10EA\u10D4\u10DC\u10D0\u10E0\u10D4\u10D4\u10D1\u10D8\u10E1\u10D2\u10D0\u10DC,
      \u10E0\u10DD\u10D2\u10DD\u10E0\u10EA \u10D6\u10E6\u10D5\u10D8\u10E1 \u10DE\u10D0\u10E2\u10D0\u10E0\u10D0
      \u10E1\u10D0\u10D7\u10D8\u10D1\u10D4\u10D1\u10D8!\n\u10D6\u10DD\u10D2\u10D8
      \u10DB\u10D0\u10D7\u10D2\u10D0\u10DC\u10D8 \u10D9\u10D8 \u10D7\u10D0\u10D5\u10E1
      \u10DB\u10DD\u10DA\u10E3\u10E1\u10D9\u10D8\u10E1 \u10DC\u10D8\u10DF\u10D0\u10E0\u10D4\u10D1\u10D8\u10D7\u10D0
      \u10D3\u10D0 \u10DE\u10D0\u10E2\u10D0\u10E0\u10D0 \u10E5\u10D5\u10D4\u10D1\u10D8\u10D7
      \u10D8\u10E4\u10D0\u10E0\u10D0\u10D5\u10E1 \u2014 \u10D7\u10D8\u10D7\u10E5\u10DD\u10E1
      \u10E8\u10D4\u10DC\u10D8\u10E6\u10D1\u10D5\u10D8\u10E1 \u10E5\u10E3\u10D3\u10D8
      \u10D4\u10EE\u10E3\u10E0\u10DD\u10E1!"
