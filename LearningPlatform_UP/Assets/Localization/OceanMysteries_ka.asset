  - m_Id: 93960068333568
    m_Localized: "\u10D6\u10E6\u10D5\u10D8\u10E1 \u10DB\u10DD\u10D2\u10D6\u10D0\u10E3\u10E0\u10D8!\n\u10D6\u10E6\u10D5\u10D8\u10E1
      \u10D9\u10E3\u10D4\u10D1\u10D8 \u10E8\u10D4\u10D8\u10EB\u10DA\u10D4\u10D1\u10D0
      50 \u10EC\u10D4\u10DA\u10D6\u10D4 \u10DB\u10D4\u10E2\u10D8\u10EA \u10D8\u10EA\u10DD\u10EA\u10EE\u10DA\u10DD\u10DC
      \u10D3\u10D0 \u10D0\u10D7\u10D0\u10E1\u10DD\u10D1\u10D8\u10D7 \u10D9\u10D8\u10DA\u10DD\u10DB\u10D4\u10E2\u10E0\u10D8
      \u10D2\u10D0\u10D8\u10D0\u10E0\u10DD\u10DC \u10DD\u10D9\u10D4\u10D0\u10DC\u10D4\u10E8\u10D8.\n\u10DB\u10D0\u10D7
      \u10E7\u10DD\u10D5\u10D4\u10DA\u10D7\u10D5\u10D8\u10E1 \u10D0\u10EE\u10E1\u10DD\u10D5\u10D7
      \u10D8\u10E1 \u10E1\u10D0\u10DC\u10D0\u10DE\u10D8\u10E0\u10DD, \u10E1\u10D0\u10D3\u10D0\u10EA
      \u10D2\u10D0\u10E9\u10DC\u10D3\u10DC\u10D4\u10DC \u2014 \u10E1\u10EC\u10DD\u10E0\u10D4\u10D3
      \u10D8\u10E5 \u10D1\u10E0\u10E3\u10DC\u10D3\u10D4\u10D1\u10D8\u10D0\u10DC \u10D9\u10D5\u10D4\u10E0\u10EA\u10EE\u10D4\u10D1\u10D8\u10E1
      \u10D3\u10D0\u10E1\u10D0\u10D3\u10D4\u10D1\u10D0\u10D3, \u10D7\u10D8\u10D7\u10E5\u10DD\u10E1
      \u10E8\u10D8\u10D3\u10D0 GPS \u10F0\u10E5\u10DD\u10DC\u10D3\u10D4\u10D7!\n\u10EB\u10DA\u10D8\u10D4\u10E0\u10D8
      \u10E4\u10D0\u10E0\u10E4\u10DA\u10D4\u10D1\u10D8\u10E1 \u10D3\u10D0\u10EE\u10DB\u10D0\u10E0\u10D4\u10D1\u10D8\u10D7
      \u10D8\u10E1\u10D8\u10DC\u10D8 \u10EC\u10E7\u10D0\u10DA\u10E8\u10D8 \u10D4\u10DA\u10D4\u10D2\u10D0\u10DC\u10E2\u10E3\u10E0\u10D0\u10D3
      \u10E1\u10E0\u10D8\u10D0\u10DA\u10D4\u10D1\u10D4\u10DC, \u10E0\u10DD\u10D2\u10DD\u10E0\u10EA
      \u10E4\u10E0\u10D8\u10DC\u10D5\u10D4\u10DA\u10D4\u10D1\u10D8 \u10EA\u10D0\u10E8\u10D8.\n\u10D8\u10E1\u10D8\u10DC\u10D8
      \u10D9\u10E0\u10D8\u10DA\u10D4\u10D1\u10D8\u10D7\u10D0 \u10D3\u10D0 \u10EC\u10E7\u10D0\u10DA\u10DB\u10EA\u10D4\u10DC\u10D0\u10E0\u10D4\u10D4\u10D1\u10D8\u10D7
      \u10D8\u10D9\u10D5\u10D4\u10D1\u10D4\u10D1\u10D8\u10D0\u10DC \u10D3\u10D0 \u10D0\u10E1\u10D4
      \u10DD\u10D9\u10D4\u10D0\u10DC\u10D8\u10E1 \u10E1\u10D8\u10E1\u10E3\u10E4\u10D7\u10D0\u10D5\u10D4\u10E1\u10D0\u10EA
      \u10E3\u10EC\u10E7\u10DD\u10D1\u10D4\u10DC \u10EE\u10D4\u10DA\u10E1 \u2014
      \u10DC\u10D0\u10DB\u10D3\u10D5\u10D8\u10DA\u10D8 \u10D1\u10E3\u10DC\u10D4\u10D1\u10E0\u10D8\u10D5\u10D8
      \u10D3\u10D0\u10DB\u10DA\u10D0\u10D2\u10D4\u10D1\u10DA\u10D4\u10D1\u10D8 \u10D0\u10E0\u10D8\u10D0\u10DC!"
