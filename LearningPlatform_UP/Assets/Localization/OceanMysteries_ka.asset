  - m_Id: 93862701760512
    m_Localized: "\u10DB\u10D4\u10D3\u10E3\u10D6\u10D4\u10D1\u10D8 \u10DD\u10D9\u10D4\u10D0\u10DC\u10D4\u10D4\u10D1\u10E8\u10D8
      \u10E3\u10D9\u10D5\u10D4 500 \u10DB\u10D8\u10DA\u10D8\u10DD\u10DC \u10EC\u10D4\u10DA\u10D6\u10D4
      \u10DB\u10D4\u10E2\u10D8\u10D0 \u10D3\u10D0\u10EA\u10E3\u10E0\u10D0\u10D5\u10D4\u10DC
      \u2014 \u10D1\u10D4\u10D5\u10E0\u10D0\u10D3 \u10D0\u10D3\u10E0\u10D4, \u10D5\u10D8\u10D3\u10E0\u10D4
      \u10D3\u10D8\u10DC\u10DD\u10D6\u10D0\u10D5\u10E0\u10D4\u10D1\u10D8 \u10D0\u10E0\u10E1\u10D4\u10D1\u10DD\u10D1\u10D3\u10DC\u10D4\u10DC!\n\u10DB\u10D0\u10D7
      \u10D0\u10E0 \u10D0\u10E5\u10D5\u10D7 \u10E2\u10D5\u10D8\u10DC\u10D8, \u10D2\u10E3\u10DA\u10D8
      \u10D0\u10DC \u10EB\u10D5\u10DA\u10D4\u10D1\u10D8, \u10DB\u10D0\u10D2\u10E0\u10D0\u10DB
      \u10DB\u10D0\u10D8\u10DC\u10EA \u10DB\u10DD\u10EB\u10E0\u10D0\u10DD\u10D1\u10D4\u10DC
      \u10D3\u10D0 \u10E1\u10D0\u10D9\u10D5\u10D4\u10D1\u10E1 \u10DB\u10E2\u10D9\u10D8\u10D5\u10DC\u10D4\u10E3\u10DA\u10D8
      \u10E1\u10D0\u10EA\u10D4\u10EA\u10D4\u10D1\u10D8\u10D7 \u10D8\u10ED\u10D4\u10E0\u10D4\u10DC.\n\u10D8\u10E1\u10D8\u10DC\u10D8
      \u10D0\u10DC\u10D0\u10D7\u10D4\u10D1\u10D4\u10DC, \u10DE\u10E3\u10DA\u10E1\u10D8\u10E0\u10D4\u10D1\u10D4\u10DC
      \u10D3\u10D0 \u10EA\u10E3\u10E0\u10D0\u10D5\u10D4\u10DC, \u10D7\u10D8\u10D7\u10E5\u10DD\u10E1
      \u10DD\u10D9\u10D4\u10D0\u10DC\u10D8\u10E1 \u10DB\u10DD\u10E9\u10D5\u10D4\u10DC\u10D4\u10D1\u10D4\u10D1\u10D8
      \u10D8\u10E7\u10D5\u10DC\u10D4\u10DC, \u10D3\u10D0 \u10DB\u10D0\u10E0\u10E2\u10D8\u10D5\u10D0\u10D3
      \u10DB\u10D8\u10F0\u10E7\u10D5\u10D4\u10D1\u10D8\u10D0\u10DC \u10EC\u10E7\u10DA\u10D8\u10E1
      \u10D3\u10D8\u10DC\u10D4\u10D1\u10D4\u10D1\u10E1.\n\u10D6\u10DD\u10D2\u10D8
      \u10DE\u10D0\u10E2\u10D0\u10E0\u10D0\u10D0, \u10D6\u10DD\u10D2\u10D8 \u10E3\u10D6\u10D0\u10E0\u10DB\u10D0\u10D6\u10D0\u10E0\u10D8
      \u2014 \u10DB\u10D0\u10D2\u10E0\u10D0\u10DB \u10E7\u10D5\u10D4\u10DA\u10D0
      \u10E3\u10DA\u10D0\u10DB\u10D0\u10D6\u10D4\u10E1\u10D8 \u10E1\u10D0\u10DD\u10EA\u10E0\u10D4\u10D1\u10D0\u10D0
      \u10D6\u10E6\u10D5\u10D8\u10E1 \u10E1\u10D8\u10E6\u10E0\u10DB\u10D8\u10D3\u10D0\u10DC."
