  - m_Id: 277936929234944
    m_Localized: "\u10D9\u10D4\u10DA\u10DE\u10D8 \u10EC\u10E7\u10D0\u10DA\u10DB\u10EA\u10D4\u10DC\u10D0\u10E0\u10D4\u10D4\u10D1\u10D8\u10E1
      \u10D2\u10D8\u10D2\u10D0\u10DC\u10E2\u10D8\u10D0. \u10D8\u10E1 \u10D3\u10E6\u10D4\u10E8\u10D8
      60 \u10E1\u10D0\u10DC\u10E2\u10D8\u10DB\u10D4\u10E2\u10E0\u10D0\u10DB\u10D3\u10D4
      \u10D8\u10D6\u10E0\u10D3\u10D4\u10D1\u10D0! \u10D9\u10D4\u10DA\u10DE\u10D8\u10E1
      \u10E2\u10E7\u10D4\u10D4\u10D1\u10D8 \u10EC\u10D0\u10D0\u10D2\u10D0\u10D5\u10E1
      \u10EC\u10E7\u10D0\u10DA\u10E5\u10D5\u10D4\u10E8\u10D0 \u10EF\u10E3\u10DC\u10D2\u10DA\u10D4\u10D1\u10E1
      \u2014 \u10D8\u10E1\u10D8\u10DC\u10D8 \u10D8\u10EB\u10DA\u10D4\u10D5\u10D8\u10D0\u10DC
      \u10E1\u10D0\u10D9\u10D5\u10D4\u10D1\u10E1 \u10D3\u10D0 \u10D7\u10D0\u10D5\u10E8\u10D4\u10E1\u10D0\u10E4\u10D0\u10E0\u10E1
      \u10D6\u10E6\u10D5\u10D8\u10E1 \u10E4\u10DD\u10EE\u10DD\u10E9\u10D4\u10D1\u10E1,
      \u10D7\u10D4\u10D5\u10D6\u10D4\u10D1\u10E1 \u10D3\u10D0 \u10E1\u10EE\u10D5\u10D0
      \u10EA\u10DD\u10EA\u10EE\u10D0\u10DA \u10D0\u10E0\u10E1\u10D4\u10D1\u10D4\u10D1\u10E1."
    m_Metadata:
      m_Items: []
  - m_Id: 277954998296576
    m_Localized: "\u10E4\u10D8\u10E2\u10DD\u10DE\u10DA\u10D0\u10DC\u10E5\u10E2\u10DD\u10DC\u10D8\u10E1
      \u10EC\u10D5\u10D4\u10D7\u10D8"
