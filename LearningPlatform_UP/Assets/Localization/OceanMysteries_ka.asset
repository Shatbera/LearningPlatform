  - m_Id: 93886022090752
    m_Localized: "\u10DA\u10D0\u10DB\u10D0\u10D6\u10D8, \u10DB\u10D0\u10D2\u10E0\u10D0\u10DB
      \u10E1\u10D0\u10E8\u10D8\u10E8\u10D8!\n\u10DA\u10DD\u10DB\u10D7\u10D4\u10D5\u10D6\u10D0
      \u10E4\u10D4\u10E0\u10D0\u10D3 \u10D6\u10DD\u10DA\u10D4\u10D1\u10E8\u10D8\u10D0
      \u10D3\u10D0\u10E4\u10D0\u10E0\u10E3\u10DA\u10D8 \u10D3\u10D0 \u10D2\u10E0\u10EB\u10D4\u10DA\u10D8,
      \u10DB\u10DD\u10EB\u10E0\u10D0\u10D5\u10D8 \u10EC\u10D0\u10EC\u10D5\u10D4\u10E2\u10D8\u10DA\u10DD\u10D1\u10D4\u10D1\u10D8
      \u10D0\u10E5\u10D5\u10E1 \u2014 \u10EC\u10E7\u10D0\u10DA\u10E8\u10D8 \u10D7\u10D8\u10D7\u10E5\u10DD\u10E1
      \u10DA\u10DD\u10DB\u10D8\u10E1 \u10E4\u10D0\u10E4\u10D0\u10E0\u10D8\u10D0!\n\u10DB\u10D0\u10D2\u10E0\u10D0\u10DB
      \u10DC\u10E3 \u10DB\u10DD\u10D2\u10D0\u10E2\u10E7\u10E3\u10D4\u10D1\u10E1 \u10DB\u10D8\u10E1\u10D8
      \u10E1\u10D8\u10DA\u10D0\u10DB\u10D0\u10D6\u10D4 \u2014 \u10D0\u10DB \u10EC\u10D0\u10EC\u10D5\u10D4\u10E2\u10D8\u10DA\u10DD\u10D1\u10D4\u10D1\u10E8\u10D8
      \u10E8\u10EE\u10D0\u10DB\u10D8\u10D0 \u10D3\u10D0 \u10DB\u10E2\u10D0\u10EA\u10D4\u10D1\u10DA\u10D4\u10D1\u10D8\u10E1
      \u10DB\u10DD\u10E8\u10DD\u10E0\u10D4\u10D1\u10D0\u10E8\u10D8 \u10D4\u10EE\u10DB\u10D0\u10E0\u10D4\u10D1\u10D0.\n\u10D8\u10E1
      \u10DC\u10D0\u10D3\u10D8\u10E0\u10DD\u10D1\u10E1 \u10D4\u10DA\u10D5\u10D8\u10E1
      \u10E1\u10D8\u10E1\u10EC\u10E0\u10D0\u10E4\u10D8\u10D7 \u10D3\u10D0 \u10EA\u10DC\u10DD\u10D1\u10D8\u10DA\u10D8\u10D0,
      \u10E0\u10DD\u10D2\u10DD\u10E0\u10EA \u10E4\u10D0\u10E0\u10E3\u10DA\u10D0\u10D3
      \u10E8\u10D4\u10DB\u10DD\u10DE\u10D0\u10E0\u10E3\u10DA\u10D8 \u10DB\u10DD\u10DC\u10D0\u10D3\u10D8\u10E0\u10D4
      \u10DB\u10D0\u10E0\u10EF\u10DC\u10D8\u10E1 \u10E0\u10D8\u10E4\u10D4\u10D1\u10E8\u10D8."
