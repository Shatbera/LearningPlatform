    m_Localized: "\u10EA\u10DD\u10EA\u10EE\u10D0\u10DA\u10D8 \u10E4\u10DD\u10D7\u10DD\u10DA\u10D8!\n\u10D6\u10E6\u10D5\u10D8\u10E1
