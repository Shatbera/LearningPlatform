    m_Localized: "\u10D6\u10E6\u10D5\u10D8\u10E1 \u10D6\u10E6\u10D0\u10E0\u10D1\u10D4\u10D1\u10D8
      \u10EC\u10D5\u10D4\u10E2\u10D8\u10D0\u10DC \u10D1\u10E3\u10E0\u10D7\u10D4\u10D1\u10E1
      \u10F0\u10D2\u10D5\u10D0\u10DC\u10D0\u10DC, \u10DB\u10D0\u10D2\u10E0\u10D0\u10DB
      \u10E1\u10D8\u10DC\u10D0\u10DB\u10D3\u10D5\u10D8\u10DA\u10D4\u10E8\u10D8 \u10E3\u10D0\u10DB\u10E0\u10D0\u10D5\u10D8
      \u10DE\u10D0\u10E2\u10D0\u10E0\u10D0 \u10DB\u10D8\u10DA\u10D8\u10D0\u10DC\u10D8
      \u10E4\u10D4\u10EE\u10D8\u10D7 \u10D2\u10D0\u10D3\u10D0\u10D0\u10D3\u10D2\u10D8\u10DA\u10D3\u10D4\u10D1\u10D8\u10D0\u10DC.
      \u10DB\u10D0\u10D7\u10D8 \u10D4\u10D9\u10DA\u10D4\u10D1\u10D8 \u10D8\u10EA\u10D0\u10D5\u10E1
      \u10DB\u10D0\u10D7 \u10DB\u10E2\u10D0\u10EA\u10D4\u10D1\u10D4\u10DA\u10D8 \u10D7\u10D4\u10D5\u10D6\u10D4\u10D1\u10D8\u10E1\u10D2\u10D0\u10DC
      \u10D3\u10D0 \u10EA\u10DC\u10DD\u10D1\u10D8\u10E1\u10DB\u10DD\u10E7\u10D5\u10D0\u10E0\u10D4
      \u10D9\u10D8\u10D1\u10DD\u10E0\u10E9\u10EE\u10D0\u10DA\u10D4\u10D1\u10D8\u10E1\u10D2\u10D0\u10DC."
    m_Metadata:
      m_Items: []
  - m_Id: 279038856781824
    m_Localized: "\u10D5\u10D0\u10E0\u10E1\u10D9\u10D5\u10DA\u10D0\u10D5\u10D7\u10D4\u10D5\u10D6\u10D0\u10E1
      \u10EE\u10D4\u10DA\u10D8\u10E1 \u10EC\u10D5\u10D4\u10E0\u10D8"
    m_Metadata:
      m_Items: []
  - m_Id: 279051435499520
    m_Localized: "\u10D5\u10D0\u10E0\u10E1\u10D9\u10D5\u10DA\u10D0\u10D5\u10D7\u10D4\u10D5\u10D6\u10D4\u10D1\u10E1
      \u10EE\u10D4\u10DA\u10D4\u10D1\u10D8\u10E1 \u10D3\u10D0\u10D9\u10D0\u10E0\u10D2\u10D5\u10D0
      \u10D0\u10E0 \u10D0\u10E8\u10D8\u10DC\u10D4\u10D1\u10D7 \u2014 \u10EE\u10D4\u10DA\u10D4\u10D1\u10E1
      \u10EE\u10D4\u10DA\u10D0\u10EE\u10DA\u10D0 \u10D0\u10DB\u10DD\u10E1\u10D3\u10D2\u10D4\u10DC!
      \u10D6\u10DD\u10D2\u10EF\u10D4\u10E0 \u10D9\u10D8, \u10D7\u10E3 \u10EA\u10D4\u10DC\u10E2\u10E0\u10D0\u10DA\u10E3\u10E0\u10D8
      \u10DC\u10D0\u10EC\u10D8\u10DA\u10D8 \u10D3\u10D0\u10E0\u10E9\u10D0, \u10D4\u10E0\u10D7\u10D8
      \u10EE\u10D4\u10DA\u10D8\u10D3\u10D0\u10DC\u10D0\u10EA \u10D9\u10D8 \u10E8\u10D4\u10E3\u10EB\u10DA\u10D8\u10D0
      \u10DB\u10D7\u10D4\u10DA\u10D8 \u10E1\u10EE\u10D4\u10E3\u10DA\u10D8\u10E1 \u10D0\u10E6\u10D3\u10D2\u10D4\u10DC\u10D0."
    m_Metadata:
      m_Items: []
  - m_Id: 279071253585920
    m_Localized: "\u10DB\u10D0\u10E0\u10EF\u10DC\u10D8\u10E1 \u10DC\u10D0\u10E2\u10D4\u10EE\u10D8"
    m_Metadata:
      m_Items: []
  - m_Id: 279088307625984
    m_Localized: "\u10DB\u10D0\u10E0\u10EF\u10DC\u10D8\u10E1 \u10E0\u10D8\u10E4\u10D4\u10D1\u10D8
      \u10E8\u10D4\u10D8\u10EB\u10DA\u10D4\u10D1\u10D0 \u10E4\u10D4\u10E0\u10D0\u10D3
      \u10E5\u10D5\u10D4\u10D1\u10E1 \u10F0\u10D2\u10D0\u10D5\u10D3\u10D4\u10E1,
      \u10DB\u10D0\u10D2\u10E0\u10D0\u10DB \u10D8\u10E1\u10D8\u10DC\u10D8 \u10DB\u10EA\u10D8\u10E0\u10D4
      \u10EA\u10EE\u10DD\u10D5\u10D4\u10DA\u10D4\u10D1\u10D8\u10E1 \u2014 \u10DE\u10DD\u10DA\u10D8\u10DE\u10D4\u10D1\u10D8\u10E1
      \u2014 \u10DB\u10D8\u10D4\u10E0 \u10D0\u10E0\u10D8\u10E1 \u10E8\u10D4\u10E5\u10DB\u10DC\u10D8\u10DA\u10D8.
      \u10D7\u10D8\u10D7\u10DD\u10D4\u10E3\u10DA\u10D8 \u10DE\u10DD\u10DA\u10D8\u10DE\u10D8
      \u10D0\u10E8\u10D4\u10DC\u10D4\u10D1\u10E1 \u10DB\u10E7\u10D0\u10E0 \u10D2\u10D0\u10E0\u10E1\u10E1,
      \u10D3\u10D0 \u10D4\u10E0\u10D7\u10D0\u10D3 \u10E5\u10DB\u10DC\u10D8\u10D0\u10DC
      \u10D9\u10DD\u10DA\u10DD\u10DC\u10D8\u10D4\u10D1\u10E1 \u2014 \u10E3\u10D0\u10DB\u10E0\u10D0\u10D5\u10D8
      \u10D6\u10E6\u10D5\u10D8\u10E1 \u10D0\u10E0\u10E1\u10D4\u10D1\u10D8\u10E1\u10D7\u10D5\u10D8\u10E1
      \u10E1\u10D0\u10EE\u10DA\u10E1."
    m_Metadata:
      m_Items: []
  - m_Id: 279106825478144
    m_Localized: "\u10D6\u10E6\u10D5\u10D8\u10E1 \u10D9\u10D8\u10E2\u10E0\u10D8\u10E1
      \u10D9\u10D0\u10DC\u10D8"
    m_Metadata:
      m_Items: []
  - m_Id: 279123808215040
    m_Localized: "\u10D6\u10E6\u10D5\u10D8\u10E1 \u10D9\u10D8\u10E2\u10E0\u10D4\u10D1\u10D8
      \u10DC\u10D4\u10DA\u10D0 \u10D2\u10D0\u10D3\u10D0\u10D0\u10D3\u10D2\u10D8\u10DA\u10D3\u10D4\u10D1\u10D8\u10D0\u10DC
      \u10E4\u10E1\u10D9\u10D4\u10E0\u10D6\u10D4 \u10D3\u10D0 \u10D7\u10D0\u10DC
      \u10E1\u10D0\u10DB\u10D0\u10E0\u10D0\u10D2\u10DD\u10D3 \u10EC\u10DB\u10D4\u10DC\u10D3\u10D4\u10DC.
      \u10D8\u10E1\u10D8\u10DC\u10D8 \u10E8\u10D7\u10D0\u10DC\u10D7\u10E5\u10D0\u10D5\u10D4\u10DC
      \u10E5\u10D5\u10D8\u10E8\u10D0\u10E1, \u10E8\u10D8\u10D2\u10DC\u10D8\u10D3\u10D0\u10DC
      \u10D8\u10E6\u10D4\u10D1\u10D4\u10DC \u10E1\u10D0\u10E1\u10D0\u10E0\u10D2\u10D4\u10D1\u10DA\u10DD
      \u10DC\u10D8\u10D5\u10D7\u10D8\u10D4\u10E0\u10D4\u10D1\u10D4\u10D1\u10E1 \u10D3\u10D0
      \u10D3\u10D0\u10E2\u10DD\u10D5\u10D4\u10D1\u10D4\u10DC \u10E1\u10E3\u10E4\u10D7\u10D0
      \u10DD\u10D9\u10D4\u10D0\u10DC\u10D8\u10E1 \u10E4\u10E1\u10D9\u10D4\u10E0\u10E1
      \u2014 \u10E0\u10DD\u10D2\u10DD\u10E0\u10EA \u10DE\u10D0\u10E2\u10D0\u10E0\u10D0
      \u10EC\u10E7\u10D0\u10DA\u10E5\u10D5\u10D4\u10E8\u10D0 \u10DB\u10E2\u10D5\u10D4\u10E0\u10E1\u10D0\u10E1\u10E0\u10E3\u10E2\u10D4\u10D1\u10D8."
    m_Metadata:
      m_Items: []
  - m_Id: 279136017833984
    m_Localized: "\u10DA\u10DD\u10D9\u10DD\u10D9\u10D8\u10DC\u10D8\u10E1 \u10DC\u10D8\u10DF\u10D0\u10E0\u10D0"
    m_Metadata:
      m_Items: []
  - m_Id: 279147510226944
    m_Localized: "\u10D6\u10E6\u10D5\u10D8\u10E1 \u10DA\u10DD\u10D9\u10DD\u10D9\u10D8\u10DC\u10D4\u10D1\u10E1
      \u10D7\u10D0\u10D5\u10D8\u10D0\u10DC\u10D7\u10D8 \u10E1\u10D0\u10EE\u10DA\u10D8
      \u10D6\u10E3\u10E0\u10D2\u10D6\u10D4 \u10D0\u10E5\u10D5\u10D7. \u10D2\u10D0\u10D3\u10D0\u10D0\u10D3\u10D2\u10D8\u10DA\u10D4\u10D1\u10D8\u10E1\u10D0\u10E1
      \u10D8\u10E1\u10D8\u10DC\u10D8 \u10E5\u10D5\u10D8\u10E8\u10D0\u10D6\u10D4 \u10D9\u10D5\u10D0\u10DA\u10E1
      \u10E2\u10DD\u10D5\u10D4\u10D1\u10D4\u10DC, \u10D6\u10DD\u10D2\u10D8 \u10D9\u10D8
      \u10E1\u10EE\u10D5\u10D0 \u10DC\u10D8\u10DF\u10D0\u10E0\u10D4\u10D1\u10E8\u10D8
      \u10EE\u10D5\u10E0\u10D4\u10DA\u10E1 \u10D0\u10D9\u10D4\u10D7\u10D4\u10D1\u10E1,
      \u10E0\u10DD\u10DB \u10E8\u10D8\u10D2\u10DC\u10D8\u10D7 \u10DB\u10E7\u10DD\u10E4\u10D8
      \u10EA\u10EE\u10DD\u10D5\u10D4\u10DA\u10D8 \u10E8\u10D4\u10ED\u10D0\u10DB\u10DD\u10E1."
