      \u10DB\u10D8\u10D8\u10EC\u10D4\u10D1\u10DD\u10E1!\n\u10DB\u10D8\u10E1\u10D8
      \u10D3\u10D0\u10EE\u10DB\u10D0\u10E0\u10D4\u10D1\u10D8\u10D7 \u10D8\u10E1 \u10DB\u10D8\u10D4\u10EC\u10D4\u10DE\u10D4\u10D1\u10D0
      \u10D6\u10D5\u10D8\u10D2\u10D4\u10DC\u10D4\u10D1\u10E1, \u10D5\u10D4\u10E8\u10D0\u10DE\u10D4\u10D1\u10E1
