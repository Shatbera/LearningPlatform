  - m_Id: 16223143190528
    m_Localized: "\u10E1\u10E2\u10D8\u10DC\u10D2\u10E0\u10D4\u10D8"
    m_Metadata:
      m_Items: []
  - m_Id: 25058125799424
    m_Localized: "\u10DA\u10D0\u10D1\u10DD\u10E0\u10D0\u10E2\u10DD\u10E0\u10D8\u10D0"
    m_Metadata:
      m_Items: []
  - m_Id: 93635747971072
    m_Localized: "\u10D4\u10E1 \u10E6\u10E0\u10DB\u10D0 \u10D6\u10E6\u10D5\u10D8\u10E1
      \u10DB\u10E2\u10D0\u10EA\u10D4\u10D1\u10D4\u10DA\u10D8 \u10D1\u10DC\u10D4\u10DA\u10E8\u10D8
      \u10E1\u10D0\u10D9\u10D5\u10D4\u10D1\u10D8\u10E1 \u10DB\u10DD\u10E1\u10D0\u10D6\u10D8\u10D3\u10D0\u10D3
      \u10DB\u10D0\u10DC\u10D0\u10D7\u10DD\u10D1\u10D4\u10DA \u10D0\u10DC\u10D9\u10D4\u10E1\u10E1
      \u10D8\u10E7\u10D4\u10DC\u10D4\u10D1\u10E1!\n\u10D0\u10DC\u10D2\u10DA\u10D4\u10E0\u10D8\u10E1
      \u10D7\u10D4\u10D5\u10D6\u10D8 \u10EA\u10EE\u10DD\u10D5\u10E0\u10DD\u10D1\u10E1
      \u10DD\u10D9\u10D4\u10D0\u10DC\u10D8\u10E1 \u10E1\u10D8\u10D1\u10DC\u10D4\u10DA\u10D4\u10E8\u10D8,
      \u10E1\u10D0\u10D3\u10D0\u10EA \u10E1\u10D8\u10DC\u10D0\u10D7\u10DA\u10D4 \u10D0\u10E0
      \u10D0\u10E6\u10EC\u10D4\u10D5\u10E1. \u10DB\u10D0\u10E1 \u10D7\u10D0\u10D5\u10D8\u10E1\u10D6\u10D4
      \u10D0\u10E5\u10D5\u10E1 \u10D4\u10E0\u10D7\u10D2\u10D5\u10D0\u10E0\u10D8 \u10D0\u10DC\u10D9\u10D4\u10E1\u10D8,
      \u10E0\u10DD\u10DB\u10DA\u10D8\u10E1 \u10EC\u10D5\u10D4\u10E0\u10D8 \u10D0\u10DC\u10D0\u10D7\u10D4\u10D1\u10E1
      \u2014 \u10D0\u10DB\u10D0\u10E1 \u10D1\u10D8\u10DD\u10DA\u10E3\u10DB\u10D8\u10DC\u10D4\u10E1\u10EA\u10D4\u10DC\u10E2\u10E3\u10E0\u10D8
      \u10DA\u10E3\u10E0\u10D8 \u10D4\u10EC\u10DD\u10D3\u10D4\u10D1\u10D0. \u10D7\u10D4\u10D5\u10D6\u10D8
      \u10D0\u10DB \u10EC\u10D5\u10D4\u10E0\u10E1 \u10D0\u10E0\u10EE\u10D4\u10D5\u10E1,
      \u10E0\u10D0\u10D7\u10D0 \u10D3\u10D0\u10D8\u10DC\u10E2\u10D4\u10E0\u10D4\u10E1\u10D4\u10D1\u10E3\u10DA\u10D8
      \u10DB\u10E1\u10EE\u10D5\u10D4\u10E0\u10DE\u10DA\u10D8 \u10DB\u10DD\u10D8\u10D6\u10D8\u10D3\u10DD\u10E1
      \u2014 \u10D3\u10D0 \u10E0\u10DD\u10D2\u10DD\u10E0\u10EA \u10D9\u10D8 \u10D0\u10EE\u10DA\u10DD\u10E1
      \u10DB\u10D8\u10D5\u10D0, \u10E9\u10EE\u10D0\u10DE! \u10D5\u10D0\u10EE\u10E8\u10D0\u10DB\u10D8
      \u10DB\u10D6\u10D0\u10D3\u10D0\u10D0."
    m_Metadata:
      m_Items: []
  - m_Id: 93695680380928
    m_Localized: "\u10D4\u10E1 \u10DB\u10D4\u10D3\u10E3\u10D6\u10D0 \u10D1\u10D8\u10DC\u10D0\u10D3\u10E0\u10DD\u10D1\u10E1
      \u10DD\u10D9\u10D4\u10D0\u10DC\u10D8\u10E1 \u10E1\u10D8\u10E6\u10E0\u10DB\u10D4\u10E8\u10D8,
      \u10E1\u10D0\u10D3\u10D0\u10EA \u10DB\u10E3\u10D3\u10D0\u10DB \u10D1\u10DC\u10D4\u10DA\u10D8\u10D0.\n\u10E1\u10D8\u10D1\u10DC\u10D4\u10DA\u10E8\u10D8
      \u10D2\u10D0\u10D3\u10D0\u10E0\u10E9\u10D4\u10DC\u10D8\u10E1\u10D7\u10D5\u10D8\u10E1
      \u10D8\u10E1 \u10D0\u10DC\u10D0\u10D7\u10D4\u10D1\u10E1 \u2014 \u10D4\u10E1
      \u10E3\u10DC\u10D0\u10E0\u10D8 \u10D1\u10D8\u10DD\u10DA\u10E3\u10DB\u10D8\u10DC\u10D4\u10E1\u10EA\u10D4\u10DC\u10EA\u10D8\u10D0
      \u10F0\u10E5\u10D5\u10D8\u10D0.\n\u10E1\u10D0\u10D9\u10E3\u10D7\u10D0\u10E0
      \u10E1\u10D8\u10DC\u10D0\u10D7\u10DA\u10D4\u10E1 \u10D8\u10E7\u10D4\u10DC\u10D4\u10D1\u10E1
      \u10DB\u10E2\u10D0\u10EA\u10D4\u10D1\u10DA\u10D4\u10D1\u10D8\u10E1 \u10D3\u10D0\u10E1\u10D0\u10E4\u10E0\u10D7\u10EE\u10DD\u10D1\u10D0\u10D3,
      \u10DB\u10D4\u10D2\u10DD\u10D1\u10E0\u10D4\u10D1\u10D8\u10E1 \u10DB\u10DD\u10E1\u10D0\u10EB\u10D4\u10D1\u10DC\u10D0\u10D3
      \u10D0\u10DC \u10DE\u10D0\u10E2\u10D0\u10E0\u10D0 \u10E1\u10D0\u10D9\u10D5\u10D4\u10D1\u10D8\u10E1
      \u10DB\u10DD\u10E1\u10D0\u10D6\u10D8\u10D3\u10D0\u10D3.\n\u10DB\u10D8\u10E1
      \u10E1\u10EE\u10D4\u10E3\u10DA\u10E8\u10D8 \u10D0\u10E0\u10D8\u10E1 \u10DE\u10D0\u10E2\u10D0\u10E0\u10D0
      \u10DC\u10D8\u10D5\u10D7\u10D8\u10D4\u10E0\u10D4\u10D1\u10D4\u10D1\u10D8, \u10E0\u10DD\u10DB\u10DA\u10D4\u10D1\u10D8\u10EA
      \u10E1\u10D8\u10DC\u10D0\u10D7\u10DA\u10D4\u10E1 \u10EC\u10D0\u10E0\u10DB\u10DD\u10E5\u10DB\u10DC\u10D8\u10D0\u10DC
      \u2014 \u10D7\u10D8\u10D7\u10E5\u10DD\u10E1 \u10EA\u10DD\u10EA\u10EE\u10D0\u10DA\u10D8
      \u10E6\u10D0\u10DB\u10D8\u10E1 \u10E1\u10D0\u10DC\u10D0\u10D7\u10D8 \u10D8\u10E7\u10DD\u10E1!"
    m_Metadata:
      m_Items: []
  - m_Id: 93754048315392
    m_Localized: "\u10D9\u10DA\u10DD\u10E3\u10DC\u10E4\u10D8\u10E8\u10D8 \u10D3\u10D0
      \u10D6\u10E6\u10D5\u10D8\u10E1 \u10D0\u10DC\u10D4\u10DB\u10DD\u10DC\u10D8 \u10E1\u10D0\u10DD\u10EA\u10D0\u10E0
      \u10DB\u10D4\u10D2\u10DD\u10D1\u10E0\u10DD\u10D1\u10D0\u10E1 \u10E5\u10DB\u10DC\u10D8\u10D0\u10DC
      \u2014 \u10D0\u10DC\u10D4\u10DB\u10DD\u10DC\u10D8 \u10D8\u10EA\u10D0\u10D5\u10E1
      \u10D7\u10D4\u10D5\u10D6\u10E1 \u10DB\u10E2\u10E0\u10D8\u10E1\u10D2\u10D0\u10DC,
      \u10D9\u10DA\u10DD\u10E3\u10DC\u10E4\u10D8\u10E8\u10D8 \u10D9\u10D8 \u10D0\u10DC\u10D4\u10DB\u10DD\u10DC\u10E1
      \u10D0\u10E1\u10E3\u10E4\u10D7\u10D0\u10D5\u10D4\u10D1\u10E1 \u10D3\u10D0 \u10D4\u10EE\u10DB\u10D0\u10E0\u10D4\u10D1\u10D0.\n\u10D0\u10DC\u10D4\u10DB\u10DD\u10DC\u10D8
      \u10DB\u10E2\u10D9\u10D8\u10D5\u10DC\u10D4\u10E3\u10DA \u10DC\u10D4\u10DB\u10E1\u10D4\u10D1\u10E1
      \u10D8\u10E7\u10D4\u10DC\u10D4\u10D1\u10E1 \u10DB\u10E2\u10D0\u10EA\u10D4\u10D1\u10DA\u10D4\u10D1\u10D8\u10E1
      \u10DB\u10DD\u10E1\u10D0\u10E8\u10DD\u10E0\u10D4\u10D1\u10DA\u10D0\u10D3, \u10DB\u10D0\u10D2\u10E0\u10D0\u10DB
      \u10D9\u10DA\u10DD\u10E3\u10DC\u10E4\u10D8\u10E8\u10E1 \u10D0\u10E0\u10D0\u10E4\u10D4\u10E0\u10D8
      \u10D4\u10DB\u10D0\u10E0\u10D7\u10D4\u10D1\u10D0 \u2014 \u10DB\u10D0\u10E1
      \u10E1\u10DE\u10D4\u10EA\u10D8\u10D0\u10DA\u10E3\u10E0\u10D8 \u10DB\u10DD\u10DA\u10D8\u10DE\u10E3\u10DA\u10D8
      \u10E1\u10D0\u10E4\u10D0\u10E0\u10D8 \u10D8\u10EA\u10D0\u10D5\u10E1.\n\u10D4\u10E1
      \u10DD\u10E0\u10D8 \u10D4\u10E0\u10D7\u10DB\u10D0\u10DC\u10D4\u10D7\u10D6\u10D4\u10D0
      \u10D3\u10D0\u10DB\u10DD\u10D9\u10D8\u10D3\u10D4\u10D1\u10E3\u10DA\u10D8 \u10D3\u10D0
      \u10D8\u10E1\u10D4 \u10D7\u10D0\u10DC\u10D0\u10EA\u10EE\u10DD\u10D5\u10E0\u10DD\u10D1\u10D4\u10DC,
      \u10D7\u10D8\u10D7\u10E5\u10DD\u10E1 \u10D6\u10E6\u10D5\u10D8\u10E1 \u10E5\u10D5\u10D4\u10E8
      \u10DC\u10D0\u10DB\u10D3\u10D5\u10D8\u10DA \u10DB\u10D4\u10D2\u10DD\u10D1\u10E0\u10DD\u10D1\u10D0\u10E1
      \u10D0\u10D5\u10D8\u10D7\u10D0\u10E0\u10D4\u10D1\u10D3\u10DC\u10D4\u10DC."
    m_Metadata:
      m_Items: []
  - m_Id: 93782888349696
    m_Localized: "\u10D9\u10D8\u10D1\u10DD\u10E0\u10E9\u10EE\u10D0\u10DA\u10D0\u10E1
      \u10EB\u10D5\u10D0\u10DA\u10D8 \u10E8\u10D8\u10D2\u10DC\u10D8\u10D7 \u10D9\u10D8
      \u10D0\u10E0\u10D0, \u10D2\u10D0\u10E0\u10D4\u10D3\u10D0\u10DC \u10D0\u10E5\u10D5\u10E1
      \u2014 \u10DB\u10D0\u10E1 \u10D4\u10D2\u10D6\u10DD\u10E1\u10D9\u10D4\u10DA\u10D4\u10E2\u10D8
      \u10D4\u10EC\u10DD\u10D3\u10D4\u10D1\u10D0 \u10D3\u10D0 \u10DC\u10D0\u10DB\u10D3\u10D5\u10D8\u10DA
      \u10EF\u10D0\u10D5\u10E8\u10D0\u10DC\u10E1 \u10F0\u10D2\u10D0\u10D5\u10E1!\n\u10D8\u10E1
      \u10D2\u10D5\u10D4\u10E0\u10D3\u10E3\u10DA\u10D0\u10D3 \u10DB\u10DD\u10EB\u10E0\u10D0\u10DD\u10D1\u10E1
      \u10EB\u10DA\u10D8\u10D4\u10E0\u10D8 \u10E4\u10D4\u10EE\u10D4\u10D1\u10D8\u10E1
      \u10D3\u10D0\u10EE\u10DB\u10D0\u10E0\u10D4\u10D1\u10D8\u10D7 \u10D3\u10D0 \u10E1\u10D0\u10D9\u10D5\u10D4\u10D1\u10D8\u10E1
      \u10D3\u10D0\u10E1\u10D0\u10ED\u10D4\u10E0\u10D0\u10D3 \u10D0\u10DC \u10D7\u10D0\u10D5\u10D8\u10E1
      \u10D3\u10D0\u10E1\u10D0\u10EA\u10D0\u10D5\u10D0\u10D3 \u10D1\u10E0\u10ED\u10E7\u10D0\u10DA\u10D4\u10D1\u10E1
      \u10D8\u10E7\u10D4\u10DC\u10D4\u10D1\u10E1.\n\u10E0\u10DD\u10EA\u10D0 \u10EB\u10D0\u10DA\u10D8\u10D0\u10DC
      \u10D8\u10D6\u10E0\u10D3\u10D4\u10D1\u10D0 \u10D3\u10D0 \u10EB\u10D5\u10D4\u10DA\u10D8
      \u10DC\u10D8\u10DF\u10D0\u10E0\u10D0 \u10D0\u10E6\u10D0\u10E0 \u10D4\u10E2\u10D4\u10D5\u10D0,
      \u10DB\u10D0\u10E1 \u10D8\u10E8\u10DA\u10D8\u10E1 \u10D3\u10D0 \u10D0\u10EE\u10D0\u10DA\u10E1
      \u10D8\u10E8\u10D4\u10DC\u10D4\u10D1\u10E1 \u2014 \u10D7\u10D8\u10D7\u10E5\u10DD\u10E1
      \u10D0\u10EE\u10D0\u10DA \u10EF\u10D0\u10D5\u10E8\u10D0\u10DC\u10E1 \u10D8\u10EA\u10D5\u10D0\u10DB\u10D3\u10D4\u10E1!"
    m_Metadata:
      m_Items: []
  - m_Id: 93809790615552
    m_Localized: "\u10D1\u10E3\u10DC\u10D4\u10D1\u10E0\u10D8\u10D5\u10D8 \u10D1\u10D0\u10E2\u10D0\u10E0\u10D4\u10D0!\n\u10D4\u10DA\u10D4\u10E5\u10E2\u10E0\u10E3\u10DA\u10D8
      \u10D2\u10D5\u10D4\u10DA\u10D7\u10D4\u10D5\u10D6\u10D0 \u10E8\u10D4\u10E3\u10EB\u10DA\u10D8\u10D0
      600 \u10D5\u10DD\u10DA\u10E2\u10D0\u10DB\u10D3\u10D4 \u10D3\u10D4\u10DC\u10D8\u10E1
      \u10D2\u10D0\u10DB\u10DD\u10E7\u10DD\u10E4\u10D0 \u2014 \u10D4\u10E1 \u10E1\u10D0\u10D9\u10DB\u10D0\u10E0\u10D8\u10E1\u10D8\u10D0,
      \u10E0\u10DD\u10DB \u10DB\u10E2\u10D0\u10EA\u10D4\u10D1\u10D4\u10DA\u10D8 \u10D3\u10D0\u10D0\u10D1\u10DC\u10D8\u10DD\u10E1
      \u10D0\u10DC \u10DB\u10E2\u10D4\u10E0\u10D8 \u10E8\u10D4\u10D0\u10E8\u10D8\u10DC\u10DD\u10E1!\n\u10D8\u10E1
      \u10D0\u10DB \u10E3\u10DC\u10D0\u10E0\u10E1 \u10D8\u10E7\u10D4\u10DC\u10D4\u10D1\u10E1
      \u10DB\u10E6\u10D5\u10E0\u10D8\u10D4, \u10D1\u10DC\u10D4\u10DA \u10EC\u10E7\u10DA\u10D4\u10D1\u10E8\u10D8
      \u10DC\u10D0\u10D3\u10D8\u10E0\u10DD\u10D1\u10D8\u10E1\u10D7\u10D5\u10D8\u10E1,
      \u10E1\u10D0\u10D3\u10D0\u10EA \u10D7\u10D5\u10D0\u10DA\u10D8\u10D7 \u10D7\u10D8\u10D7\u10E5\u10DB\u10D8\u10E1
      \u10D0\u10E0\u10D0\u10E4\u10D4\u10E0\u10D8\u10D0 \u10D3\u10D0\u10E1\u10D0\u10DC\u10D0\u10EE\u10D8.\n\u10E1\u10D0\u10D8\u10DC\u10E2\u10D4\u10E0\u10D4\u10E1\u10DD\u10D0,
      \u10E0\u10DD\u10DB \u10DB\u10D8\u10E3\u10EE\u10D4\u10D3\u10D0\u10D5\u10D0\u10D3
      \u10E1\u10D0\u10EE\u10D4\u10DA\u10D8\u10E1\u10D0, \u10E1\u10D8\u10DC\u10D0\u10DB\u10D3\u10D5\u10D8\u10DA\u10D4\u10E8\u10D8
      \u10D2\u10D5\u10D4\u10DA\u10D7\u10D4\u10D5\u10D6\u10D0 \u10E3\u10E4\u10E0\u10DD
      \u10D3\u10D0\u10DC\u10D8\u10E1 \u10D7\u10D4\u10D5\u10D6\u10E1 \u10F0\u10D2\u10D0\u10D5\u10E1,
      \u10D5\u10D8\u10D3\u10E0\u10D4 \u10DC\u10D0\u10DB\u10D3\u10D5\u10D8\u10DA \u10D2\u10D5\u10D4\u10DA\u10E1.\n\u10E1\u10EE\u10D5\u10D4\u10D1\u10D7\u10D0\u10DC
      \"\u10E1\u10D0\u10E3\u10D1\u10E0\u10DD\u10D1\u10E1\" \u10DE\u10D0\u10E2\u10D0\u10E0\u10D0
      \u10D3\u10D4\u10DC\u10DD\u10D5\u10D0\u10DC\u10D8 \u10D8\u10DB\u10DE\u10E3\u10DA\u10E1\u10D4\u10D1\u10D8\u10D7
      \u2014 \u10EC\u10E7\u10D0\u10DA\u10E5\u10D5\u10D4\u10E8\u10D0 \u10DB\u10DD\u10E0\u10D6\u10D4\u10E1
      \u10D0\u10DC\u10D1\u10D0\u10DC\u10D8\u10D5\u10D8\u10D7!"
    m_Metadata:
      m_Items: []
  - m_Id: 93841621188608
    m_Localized: "\u10DA\u10E3\u10E0\u10EF\u10D8 \u10D5\u10D4\u10E8\u10D0\u10DE\u10D8
      \u10D3\u10D4\u10D3\u10D0\u10DB\u10D8\u10EC\u10D8\u10E1 \u10E7\u10D5\u10D4\u10DA\u10D0\u10D6\u10D4
      \u10D3\u10D8\u10D3\u10D8 \u10EA\u10DD\u10EA\u10EE\u10D0\u10DA\u10D8 \u10D0\u10E0\u10E1\u10D4\u10D1\u10D0\u10D0
      \u2014 \u10D8\u10E1 \u10D0\u10D5\u10E2\u10DD\u10D1\u10E3\u10E1\u10D6\u10D4
      \u10D1\u10D4\u10D5\u10E0\u10D0\u10D3 \u10D3\u10D8\u10D3\u10D8\u10D0!\n\u10DB\u10D8\u10E1\u10D8
      \u10E3\u10D6\u10D0\u10E0\u10DB\u10D0\u10D6\u10D0\u10E0\u10D8 \u10D6\u10DD\u10DB\u10D8\u10E1
      \u10DB\u10D8\u10E3\u10EE\u10D4\u10D3\u10D0\u10D5\u10D0\u10D3, \u10DB\u10EE\u10DD\u10DA\u10DD\u10D3
      \u10E3\u10DB\u10EA\u10E0\u10DD\u10E1\u10D8 \u10D6\u10E6\u10D5\u10D8\u10E1 \u10D0\u10E0\u10E1\u10D4\u10D1\u10D8\u10D7
      \u2014 \u10D9\u10E0\u10D8\u10DA\u10D4\u10D1\u10D8\u10D7 \u10D8\u10D9\u10D5\u10D4\u10D1\u10D4\u10D1\u10D0
      \u10D3\u10D0 \u10D4\u10E0\u10D7 \u10DB\u10DD\u10E7\u10E3\u10D3\u10D4\u10D1\u10D0\u10E8\u10D8
      \u10D0\u10D7\u10D0\u10E1\u10DD\u10D1\u10D8\u10D7\u10E1 \u10E7\u10DA\u10D0\u10DE\u10D0\u10D5\u10E1.\n\u10D5\u10D4\u10E8\u10D0\u10DE\u10D8
      \u10D2\u10D0\u10DB\u10DD\u10E1\u10EA\u10D4\u10DB\u10E1 \u10E6\u10E0\u10DB\u10D0
      \u10D3\u10D0 \u10EB\u10DA\u10D8\u10D4\u10E0 \u10D1\u10D2\u10D4\u10E0\u10D4\u10D1\u10E1,
      \u10E0\u10DD\u10DB\u10DA\u10D4\u10D1\u10D8\u10EA \u10EC\u10E7\u10D0\u10DA\u10E5\u10D5\u10D4\u10E8
      \u10D0\u10E1\u10DD\u10D1\u10D8\u10D7 \u10D9\u10D8\u10DA\u10DD\u10DB\u10D4\u10E2\u10E0\u10D6\u10D4
      \u10D5\u10E0\u10EA\u10D4\u10DA\u10D3\u10D4\u10D1\u10D0 \u2014 \u10D0\u10E1\u10D4
      \u10D4\u10D7\u10D0\u10DC\u10EE\u10DB\u10D4\u10D1\u10D8\u10D0\u10DC \u10D4\u10E0\u10D7\u10DB\u10D0\u10DC\u10D4\u10D7\u10E1.\n\u10D7\u10E3\u10DB\u10EA\u10D0
      \u10D7\u10D5\u10D0\u10DA\u10D8\u10D7 \u10DB\u10EB\u10D8\u10DB\u10D4 \u10D3\u10D0
      \u10D3\u10D8\u10D3\u10D8\u10D0, \u10D8\u10E1 \u10E1\u10D8\u10DC\u10D0\u10DB\u10D3\u10D5\u10D8\u10DA\u10D4\u10E8\u10D8
      \u10DB\u10E8\u10D5\u10D8\u10D3\u10D8 \u10D3\u10D0 \u10D4\u10DA\u10D4\u10D2\u10D0\u10DC\u10E2\u10E3\u10E0\u10D8
      \u10DB\u10DD\u10D2\u10D6\u10D0\u10E3\u10E0\u10D8\u10D0 \u10D6\u10E6\u10D5\u10D4\u10D1\u10E8\u10D8."
